<!DOCTYPE html>
<html lang="vi" data-font-size="normal" data-high-contrast="false">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <title>STEP - Nền Tảng Phục Hồi Chức Năng &amp; Vật Lý Trị Liệu Thông Minh</title>
    
    <!-- Google Font: Be Vietnam Pro (Tối ưu dấu tiếng Việt & độ đọc cho người cao tuổi) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="bootstrap/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="app.css"/>
    <link rel="stylesheet" href="RehabTracking.Web.styles.css"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material3-base.css">
    
    <!-- Khởi tạo trợ năng trước khi render để chống giật giao diện -->
    <script>
        (function() {
            try {
                var size = localStorage.getItem('senior_font_size') || 'normal';
                var contrast = localStorage.getItem('senior_contrast') || 'normal';
                document.documentElement.setAttribute('data-font-size', size);
                document.documentElement.setAttribute('data-high-contrast', contrast === 'high' ? 'true' : 'false');
            } catch (e) {}
        })();
    </script>
    <HeadOutlet/>
</head>

<body>
<Routes/>
<script src="_framework/blazor.web.js"></script>
<script>
    // Smooth scroll helper for Blazor anchor links
    window.scrollToElement = function(id) {
        var el = document.getElementById(id);
        if (el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    };

    // Accessibility Helpers for Seniors
    window.setSeniorFontSize = function(size) {
        document.documentElement.setAttribute('data-font-size', size);
        try { localStorage.setItem('senior_font_size', size); } catch(e){}
    };

    window.getSeniorFontSize = function() {
        return document.documentElement.getAttribute('data-font-size') || 'normal';
    };

    window.setSeniorContrast = function(isHigh) {
        document.documentElement.setAttribute('data-high-contrast', isHigh ? 'true' : 'false');
        try { localStorage.setItem('senior_contrast', isHigh ? 'high' : 'normal'); } catch(e){}
    };

    window.getSeniorContrast = function() {
        return document.documentElement.getAttribute('data-high-contrast') === 'true';
    };

    // Web Speech API: Đọc to hướng dẫn bài tập cho người cao tuổi
    window.speakSeniorText = function(text) {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel(); // Dừng câu trước nếu đang đọc
            var utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'vi-VN';
            utterance.rate = 0.9; // Tốc độ đọc chậm rãi, rõ ràng cho người già nghe kịp
            utterance.pitch = 1.0;
            window.speechSynthesis.speak(utterance);
        }
    };

    window.stopSeniorSpeech = function() {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
        }
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>

</html>
