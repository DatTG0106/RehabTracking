<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)"/>
            <FocusOnNavigate RouteData="routeData" Selector="h1"/>
        </Found>
        <NotFound>
            <PageTitle>Không tìm thấy trang (404) – STEP</PageTitle>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="container py-5 text-center" style="max-width: 600px;">
                    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                        <div class="mb-4">
                            <span class="badge rounded-circle bg-warning-subtle text-warning p-4" style="font-size: 3rem;">
                                <i class="bi bi-compass"></i>
                            </span>
                        </div>
                        <h2 class="fw-bold text-dark mb-2">404 - Không Tìm Thấy Trang</h2>
                        <p class="text-secondary mb-4">
                            Đường dẫn bạn yêu cầu không tồn tại hoặc đã được chuyển sang địa chỉ mới trong hệ thống phục hồi chức năng STEP.
                        </p>
                        <div>
                            <a href="/" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-arrow-left me-2"></i>Quay lại Trang Chủ
                            </a>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
