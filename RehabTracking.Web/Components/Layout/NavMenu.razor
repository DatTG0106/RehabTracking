@using RehabTracking.Web.Features.ECommerce.Cart
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject CartState CartState
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable
@rendermode InteractiveServer

<nav class="senior-navbar navbar navbar-expand-lg" aria-label="Thanh điều hướng chính">
    <div class="container-fluid px-lg-4">
        <!-- Logo STEP lớn, rõ ràng -->
        <a class="navbar-brand d-flex align-items-center py-1" href="/" title="Trang chủ STEP - Phục hồi chức năng">
            <img src="/images/logo/logo.png" alt="STEP Logo" style="height: 52px; width: auto; max-height: 58px; object-fit: contain;" />
            <span class="d-none d-sm-inline-block ms-2 fw-bold text-dark fs-5" style="letter-spacing: -0.5px;">
                Phục Hồi <span style="color: var(--color-primary);">Chức Năng</span>
            </span>
        </a>

        <!-- Nút menu trên điện thoại to 52px -->
        <button class="navbar-toggler border-2 p-2 shadow-none" type="button" @onclick="ToggleMobileMenu" 
                aria-label="Mở danh mục điều hướng" style="min-width: 50px; min-height: 50px; border-color: var(--color-border-card);">
            <i class="bi @(mobileMenuOpen ? "bi-x-lg text-danger" : "bi-list text-dark") fs-3"></i>
        </button>

        <div class="@(mobileMenuOpen ? "d-block" : "collapse") navbar-collapse mt-3 mt-lg-0" id="navbarContent">
            <!-- Danh mục chính (Tối đa 5-6 mục, có icon + text to rõ) -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                <li class="nav-item" @onclick="CloseMobileMenu">
                    <NavLink class="senior-nav-link" href="/" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door-fill fs-5" style="color: var(--color-primary);"></i> Trang chủ
                    </NavLink>
                </li>
                
                <li class="nav-item" @onclick="CloseMobileMenu">
                    <NavLink class="senior-nav-link" href="exercises">
                        <i class="bi bi-collection-play-fill fs-5" style="color: var(--color-primary);"></i> Kho Bài Tập
                    </NavLink>
                </li>

                <li class="nav-item" @onclick="CloseMobileMenu">
                    <NavLink class="senior-nav-link" href="knowledge">
                        <i class="bi bi-book-half fs-5" style="color: var(--color-primary);"></i> Cẩm Nang
                    </NavLink>
                </li>

                <!-- Dành riêng cho Bệnh nhân -->
                <AuthorizeView Roles="Patient">
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="patient-dashboard">
                            <i class="bi bi-heart-pulse-fill text-danger fs-5"></i> Việc Hôm Nay
                        </NavLink>
                    </li>
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="patient/workout">
                            <i class="bi bi-play-circle-fill text-warning fs-5"></i> Tập Luyện
                        </NavLink>
                    </li>
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="patient/recovery-diary">
                            <i class="bi bi-journal-medical fs-5" style="color: var(--color-primary);"></i> Nhật Ký
                        </NavLink>
                    </li>
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="patient/ehr">
                            <i class="bi bi-file-earmark-medical-fill fs-5 text-info"></i> Bệnh Án
                        </NavLink>
                    </li>
                </AuthorizeView>

                <!-- Dành riêng cho Bác sĩ -->
                <AuthorizeView Roles="Doctor">
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="doctor-dashboard">
                            <i class="bi bi-speedometer2 fs-5" style="color: var(--color-primary);"></i> Bảng Bác Sĩ
                        </NavLink>
                    </li>
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="doctor/exercise-plans">
                            <i class="bi bi-journal-check fs-5 text-success"></i> Kê Giáo Án
                        </NavLink>
                    </li>
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="doctor/ehr">
                            <i class="bi bi-file-medical-fill fs-5 text-info"></i> Hồ Sơ EHR
                        </NavLink>
                    </li>
                </AuthorizeView>

                <!-- Dành riêng cho Quản trị viên -->
                <AuthorizeView Roles="Admin">
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="admin/orders">
                            <i class="bi bi-bag-check-fill fs-5 text-primary"></i> Đơn Hàng
                        </NavLink>
                    </li>
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="admin/inventory">
                            <i class="bi bi-boxes fs-5 text-warning"></i> Kho Hàng
                        </NavLink>
                    </li>
                    <li class="nav-item" @onclick="CloseMobileMenu">
                        <NavLink class="senior-nav-link" href="admin/accounts">
                            <i class="bi bi-people-fill fs-5 text-info"></i> Tài Khoản
                        </NavLink>
                    </li>
                </AuthorizeView>
            </ul>

            <!-- Bên phải: Giỏ hàng + Thông báo + Người dùng -->
            <ul class="navbar-nav align-items-lg-center gap-2">
                <!-- Giỏ hàng -->
                <li class="nav-item">
                    <NavLink class="senior-btn senior-btn-secondary py-2 px-3 position-relative" href="cart" aria-label="Xem giỏ hàng thiết bị">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span class="d-lg-none ms-2">Giỏ hàng</span>
                        @if (cartCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger text-white ms-1 fw-bold fs-6">
                                @(cartCount > 99 ? "99+" : cartCount.ToString())
                            </span>
                        }
                    </NavLink>
                </li>

                <AuthorizeView>
                    <Authorized>
                        <!-- Chuông thông báo y tế -->
                        <li class="nav-item">
                            <NotificationBell />
                        </li>

                        <!-- Tài khoản người dùng (Nút to, dễ bấm) -->
                        <li class="nav-item position-relative">
                            <button type="button" 
                                    class="senior-btn senior-btn-secondary d-flex align-items-center gap-2 py-2 px-3"
                                    @onclick="ToggleUserDropdown"
                                    @onclick:stopPropagation="true"
                                    aria-label="Mở menu tài khoản của tôi">
                                <div class="bg-success text-white rounded-circle d-flex justify-content-center align-items-center fw-bold"
                                     style="width:38px;height:38px;font-size:1.1rem;flex-shrink:0;">
                                    @GetInitial(context.User.Identity?.Name)
                                </div>
                                <span class="fw-bold text-dark fs-6 d-inline-block text-truncate" style="max-width:140px;">
                                    @context.User.Identity?.Name
                                </span>
                                <i class="bi bi-chevron-down ms-1"></i>
                            </button>

                            <!-- Blazor Dropdown Menu to rõ -->
                            @if (userDropdownOpen)
                            {
                                <div class="dropdown-overlay" @onclick="CloseUserDropdown"></div>

                                <div class="blazor-dropdown-menu shadow-lg p-2" @onclick:stopPropagation="true" style="min-width: 260px;">
                                    <div class="p-3 border-bottom mb-2 bg-light rounded">
                                        <div class="fw-bold text-dark fs-6">@context.User.Identity?.Name</div>
                                        <div class="text-muted small">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                        <span class="senior-badge senior-badge-success mt-2">
                                            Vai trò: @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                        </span>
                                    </div>

                                    <AuthorizeView Roles="Patient" Context="patCtx">
                                        <button class="senior-btn senior-btn-secondary w-100 text-start mb-2" @onclick='() => GoTo("/patient/profile")'>
                                            <i class="bi bi-person-badge text-primary"></i> Thông tin cá nhân
                                        </button>
                                        <button class="senior-btn senior-btn-secondary w-100 text-start mb-2" @onclick='() => GoTo("/patient/ranking")'>
                                            <i class="bi bi-trophy-fill text-warning"></i> Bảng vàng kiên trì
                                        </button>
                                        <button class="senior-btn senior-btn-secondary w-100 text-start mb-2" @onclick='() => GoTo("/patient/appointments")'>
                                            <i class="bi bi-calendar2-heart text-danger"></i> Lịch hẹn Bác sĩ
                                        </button>
                                        <button class="senior-btn senior-btn-secondary w-100 text-start mb-2" @onclick='() => GoTo("/activate-device")'>
                                            <i class="bi bi-watch text-secondary"></i> Kết nối thiết bị
                                        </button>
                                    </AuthorizeView>

                                    <button class="senior-btn w-100 text-start text-danger border border-danger-subtle bg-white mt-2" @onclick="HandleLogout">
                                        <i class="bi bi-box-arrow-right fs-5"></i> <strong>Đăng xuất tài khoản</strong>
                                    </button>
                                </div>
                            }
                        </li>
                    </Authorized>

                    <NotAuthorized>
                        <!-- Nút Đăng nhập to màu Cam nổi bật cho Người cao tuổi -->
                        <li class="nav-item ms-lg-2">
                            <NavLink class="senior-btn senior-btn-accent shadow-sm" href="login">
                                <i class="bi bi-box-arrow-in-right fs-5"></i> Đăng Nhập
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

<style>
    .blazor-dropdown-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 250px;
        background: #FFFFFF;
        border-radius: var(--radius-md);
        border: 2px solid var(--color-border-card);
        box-shadow: var(--shadow-warm-lg);
        z-index: 1050;
    }

    .dropdown-overlay {
        position: fixed;
        inset: 0;
        z-index: 1040;
        background: transparent;
    }
</style>

@code {
    private int cartCount = 0;
    private bool userDropdownOpen = false;
    private bool mobileMenuOpen = false;
    private int _currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        await SyncUserToCart();
        CartState.OnChange += HandleCartChange;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        cartCount = CartState.Items.Sum(i => i.Quantity);
    }

    private async Task SyncUserToCart()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
            {
                _currentUserId = userId;
                CartState.SetUser(userId);
            }
        }
        else
        {
            _currentUserId = 0;
            CartState.SetUser(0);
        }
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await SyncUserToCart();
        cartCount = CartState.Items.Sum(i => i.Quantity);
        await InvokeAsync(StateHasChanged);
    }

    private void HandleCartChange()
    {
        cartCount = CartState.Items.Sum(i => i.Quantity);
        InvokeAsync(StateHasChanged);
    }

    private void ToggleUserDropdown() => userDropdownOpen = !userDropdownOpen;
    private void CloseUserDropdown() => userDropdownOpen = false;
    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMobileMenu() { mobileMenuOpen = false; userDropdownOpen = false; }

    private void GoTo(string url)
    {
        userDropdownOpen = false;
        mobileMenuOpen = false;
        Navigation.NavigateTo(url);
    }

    private void HandleLogout()
    {
        userDropdownOpen = false;
        if (_currentUserId > 0)
        {
            CartState.ClearCartForUser(_currentUserId);
        }
        Navigation.NavigateTo("/api/auth/logout", forceLoad: true);
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "B";
        return name.Trim().Substring(0, 1).ToUpper();
    }

    public void Dispose()
    {
        CartState.OnChange -= HandleCartChange;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
