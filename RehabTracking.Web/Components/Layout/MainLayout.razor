@inherits LayoutComponentBase
@using Radzen.Blazor
@using RehabTracking.Web.Components.SeniorUI

<RadzenComponents @rendermode="InteractiveServer" />

<div class="page min-vh-100 d-flex flex-column">
    <!-- Thanh điều hướng chính (SeniorNavbar) -->
    <NavMenu />

    <!-- 3. Nội dung trang chính -->
    <main class="flex-grow-1 d-flex flex-column" role="main">
        <article class="content p-0 flex-grow-1">
            @Body
        </article>
        
        <!-- 4. Chân trang ấm áp, chữ to, rõ ràng chuẩn y tế -->
        <footer class="bg-white py-5 mt-auto border-top" style="border-color: var(--color-border-card) !important;" role="contentinfo">
            <div class="container py-3">
                <div class="row g-4 justify-content-between">
                    <!-- Cột 1: Giới thiệu & Hotline khẩn cấp -->
                    <div class="col-lg-5">
                        <div class="d-flex align-items-center mb-3">
                            <img src="/images/logo/logo.png" alt="STEP Logo" style="height: 56px; width: auto; object-fit: contain;" />
                            <div class="ms-2">
                                <h4 class="mb-0 fw-bold" style="color: var(--color-primary);">Hệ Thống Phục Hồi Chức Năng STEP</h4>
                                <span class="small" style="color: #334155;">Đồng hành cùng Bác và Gia đình mỗi ngày</span>
                            </div>
                        </div>
                        <p class="mb-3" style="line-height: 1.7; font-size: 1.05rem; color: #334155;">
                            Nền tảng hỗ trợ luyện tập phục hồi chức năng và vật lý trị liệu tại nhà. Kết nối trực tiếp giữa Bệnh nhân và Bác sĩ chuyên khoa, theo dõi tầm vận động chính xác qua thiết bị thông minh.
                        </p>
                        
                        <div class="p-3 rounded-4 mb-3 border d-inline-flex align-items-center gap-3" style="background-color: var(--color-primary-surface); border-color: var(--color-primary-light) !important;">
                            <i class="bi bi-headset fs-1 text-danger"></i>
                            <div>
                                <div class="small fw-bold" style="color: #334155;">Tổng đài tư vấn & trợ giúp Bác miễn phí:</div>
                                <a href="tel:0787775716" class="fs-4 fw-bold text-danger text-decoration-none">0787.775.716</a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Cột 2: Hướng dẫn người cao tuổi -->
                    <div class="col-sm-6 col-lg-3">
                        <h4 class="fw-bold mb-3" style="color: var(--color-text-main);">Dành cho Bệnh nhân</h4>
                        <ul class="list-unstyled d-flex flex-column gap-2" style="font-size: 1.05rem;">
                            <li><a href="/exercises" class="senior-footer-link"><i class="bi bi-arrow-right-short text-success"></i> Kho bài tập khớp gối & vai</a></li>
                            <li><a href="/knowledge" class="senior-footer-link"><i class="bi bi-arrow-right-short text-success"></i> Cẩm nang dinh dưỡng phục hồi</a></li>
                            <li><a href="/#faq" class="senior-footer-link"><i class="bi bi-arrow-right-short text-success"></i> Câu hỏi thường gặp</a></li>
                            <li><a href="/#warranty-policy" class="senior-footer-link"><i class="bi bi-arrow-right-short text-success"></i> Chính sách bảo hành thiết bị</a></li>
                        </ul>
                    </div>
                    
                    <!-- Cột 3: Địa chỉ trung tâm -->
                    <div class="col-sm-6 col-lg-3">
                        <h4 class="fw-bold mb-3" style="color: var(--color-text-main);">Trung tâm Hỗ trợ</h4>
                        <ul class="list-unstyled d-flex flex-column gap-2" style="font-size: 1.05rem;">
                            <li class="d-flex align-items-start">
                                <i class="bi bi-geo-alt-fill text-danger fs-5 mt-1 me-2"></i>
                                <span>600 Nguyễn Văn Cừ Nối Dài, P. An Bình, TP. Cần Thơ</span>
                            </li>
                            <li class="d-flex align-items-center">
                                <i class="bi bi-envelope-fill text-primary fs-5 me-2"></i>
                                <span>hotro@STEP.vn</span>
                            </li>
                            <li class="d-flex align-items-center">
                                <i class="bi bi-clock-history text-success fs-5 me-2"></i>
                                <span>7:00 - 21:00 (Cả Thứ 7 & CN)</span>
                            </li>
                        </ul>
                    </div>
                </div>
                
                <hr class="my-4" style="border-color: var(--color-border-card);">
                
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">
                        &copy; 2026 STEP - Bản quyền đã được bảo hộ. 
                        <a href="/terms" class="text-decoration-none text-primary ms-2"><i class="bi bi-shield-check me-1"></i>Điều khoản &amp; Bảo mật</a>
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge border bg-light text-dark px-3 py-2 fw-semibold">Chuẩn Y Tế Phục Hồi</span>
                        <span class="badge border bg-light text-dark px-3 py-2 fw-semibold">Bảo Mật Dữ Liệu</span>
                    </div>
                </div>
            </div>
        </footer>
    </main>

    <!-- 5. Thanh điều hướng cố định dưới màn hình điện thoại (Mobile Bottom Nav) -->
    <SeniorBottomNav />
</div>

<div id="blazor-error-ui">
    <div class="d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
        <span>Đã xảy ra lỗi không mong muốn.</span>
        <a href="" class="reload btn btn-sm btn-warning rounded-pill px-3">Tải lại</a>
        <a class="dismiss btn btn-sm btn-outline-light rounded-circle" style="pointer-events: auto;"><i class="bi bi-x" style="pointer-events: none;"></i></a>
    </div>
</div>

<style>
    .senior-footer-link {
        color: var(--color-text-main) !important;
        text-decoration: none !important;
        display: inline-block;
        transition: transform 0.2s ease, color 0.2s ease;
    }
    .senior-footer-link:hover {
        color: var(--color-primary) !important;
        transform: translateX(4px);
        text-decoration: underline !important;
    }
</style>
