@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<AuthorizeView Roles="Patient">
    <nav class="senior-bottom-nav" aria-label="Thanh điều hướng dưới cùng cho điện thoại">
        <NavLink class="senior-bottom-nav-item" href="patient-dashboard" Match="NavLinkMatch.All">
            <i class="bi bi-house-heart-fill"></i>
            <span>Trang chủ</span>
        </NavLink>

        <NavLink class="senior-bottom-nav-item" href="patient/workout">
            <i class="bi bi-play-circle-fill text-warning"></i>
            <span>Tập luyện</span>
        </NavLink>

        <NavLink class="senior-bottom-nav-item" href="patient/recovery-diary">
            <i class="bi bi-journal-medical"></i>
            <span>Nhật ký</span>
        </NavLink>

        <NavLink class="senior-bottom-nav-item" href="patient/appointments">
            <i class="bi bi-calendar-check-fill"></i>
            <span>Lịch hẹn</span>
        </NavLink>

        <NavLink class="senior-bottom-nav-item" href="patient/ehr">
            <i class="bi bi-file-earmark-medical-fill"></i>
            <span>Hồ sơ</span>
        </NavLink>
    </nav>
</AuthorizeView>

