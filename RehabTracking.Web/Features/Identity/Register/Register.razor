@page "/register"
@using MediatR
@using RehabTracking.Web.Features.Identity.Register
@inject IMediator Mediator
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Đăng ký tài khoản - STEP Phục Hồi Chức Năng</PageTitle>

<div class="py-5" style="min-height: calc(100vh - 120px); background-color: var(--color-bg-app);">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <!-- Tiêu đề trang trọng -->
                <div class="text-center mb-4">
                    <img src="/images/logo/logo.png" alt="STEP Logo" style="height: 68px; width: auto; object-fit: contain;" class="mb-3" />
                    <h1 class="fw-bold text-dark fs-2 mb-2">Đăng Ký Tài Khoản Mới</h1>
                    <p class="text-muted fs-6">Đồng hành cùng Bác sĩ trên chặng đường phục hồi sức khỏe</p>
                </div>

                <!-- Thẻ đăng ký lớn -->
                <div class="senior-card p-4 mb-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="p-3 mb-4 rounded-3 d-flex align-items-center gap-3 border border-danger-subtle bg-danger-subtle text-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-3 flex-shrink-0"></i>
                            <div class="fs-6 fw-bold">@errorMessage</div>
                        </div>
                    }

                    <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                        <DataAnnotationsValidator />

                        <!-- Họ và tên -->
                        <div class="senior-form-group mb-4">
                            <label for="fullname" class="senior-form-label">
                                <i class="bi bi-person-fill text-primary me-2"></i>Họ và tên của Bác
                            </label>
                            <InputText id="fullname" class="senior-input"
                                       @bind-Value="registerModel.FullName" 
                                       placeholder="Ví dụ: Nguyễn Văn An" />
                            <ValidationMessage For="() => registerModel.FullName" class="text-danger small mt-1 fw-bold" />
                        </div>

                        <!-- Email -->
                        <div class="senior-form-group mb-4">
                            <label for="email" class="senior-form-label">
                                <i class="bi bi-envelope-fill text-primary me-2"></i>Địa chỉ Email
                            </label>
                            <InputText id="email" class="senior-input"
                                       @bind-Value="registerModel.Email" 
                                       placeholder="email@example.com" />
                            <ValidationMessage For="() => registerModel.Email" class="text-danger small mt-1 fw-bold" />
                        </div>

                        <!-- Mật khẩu -->
                        <div class="senior-form-group mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="password" class="senior-form-label mb-0">
                                    <i class="bi bi-lock-fill text-primary me-2"></i>Mật khẩu (Tối thiểu 6 ký tự)
                                </label>
                                <button type="button" class="btn btn-link text-decoration-none p-0 text-muted small" 
                                        @onclick="TogglePassword" aria-label="Xem mật khẩu">
                                    <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill") me-1"></i>
                                    @(showPassword ? "Ẩn" : "Hiện")
                                </button>
                            </div>
                            <div class="position-relative">
                                <input type="@(showPassword ? "text" : "password")" id="password"
                                       class="senior-input"
                                       placeholder="Nhập mật khẩu Bác dễ nhớ"
                                       value="@registerModel.Password"
                                       @oninput="e => { registerModel.Password = e.Value?.ToString() ?? string.Empty; }" />
                            </div>
                            <ValidationMessage For="() => registerModel.Password" class="text-danger small mt-1 fw-bold" />

                            @if (!string.IsNullOrEmpty(registerModel.Password))
                            {
                                var strength = GetPasswordStrength(registerModel.Password);
                                <div class="mt-2 p-2 rounded bg-light border">
                                    <div class="d-flex gap-1 mb-1">
                                        @for (int i = 0; i < 4; i++)
                                        {
                                            int idx = i;
                                            <div class="flex-grow-1 rounded-pill" style="height:6px; background-color: @(idx < strength.Level ? strength.Color : "#e2e8f0");"></div>
                                        }
                                    </div>
                                    <small class="fw-bold" style="color: @strength.Color;">Mức bảo mật: @strength.Label</small>
                                </div>
                            }
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="senior-form-group mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="confirmPassword" class="senior-form-label mb-0">
                                    <i class="bi bi-lock-fill text-primary me-2"></i>Gõ lại mật khẩu trên một lần nữa
                                </label>
                                <button type="button" class="btn btn-link text-decoration-none p-0 text-muted small" 
                                        @onclick="ToggleConfirmPassword" aria-label="Xem xác nhận mật khẩu">
                                    <i class="bi @(showConfirmPassword ? "bi-eye-slash-fill" : "bi-eye-fill") me-1"></i>
                                    @(showConfirmPassword ? "Ẩn" : "Hiện")
                                </button>
                            </div>
                            <input type="@(showConfirmPassword ? "text" : "password")" id="confirmPassword"
                                   class="senior-input"
                                   placeholder="Gõ lại chính xác mật khẩu ở trên"
                                   value="@registerModel.ConfirmPassword"
                                   @oninput="e => { registerModel.ConfirmPassword = e.Value?.ToString() ?? string.Empty; }" />
                            <ValidationMessage For="() => registerModel.ConfirmPassword" class="text-danger small mt-1 fw-bold" />
                        </div>

                        <!-- Nút hoàn tất đăng ký -->
                        <div class="d-grid mt-4 mb-3">
                            <button type="submit" class="senior-btn senior-btn-primary senior-btn-hero w-100" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Hệ thống đang tạo tài khoản...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle fs-4"></i>
                                    <span>HOÀN TẤT ĐĂNG KÝ</span>
                                }
                            </button>
                        </div>
                    </EditForm>

                    <div class="text-center pt-3 border-top mt-3">
                        <span class="text-muted fs-6">Bác đã có tài khoản rồi?</span>
                        <a href="/login" class="fw-bold ms-1" style="color: var(--color-primary);">Đăng nhập ngay</a>
                    </div>
                </div>

                <div class="p-3 text-center text-muted small">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i>
                    Toàn bộ thông tin sức khỏe và danh tính của Bác được bảo mật y tế tuyệt đối.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private string errorMessage = string.Empty;
    private bool isSubmitting = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;

    private void TogglePassword() => showPassword = !showPassword;
    private void ToggleConfirmPassword() => showConfirmPassword = !showConfirmPassword;

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;
        isSubmitting = true;

        try
        {
            var result = await Mediator.Send(new RegisterCommand
            {
                FullName = registerModel.FullName,
                Email = registerModel.Email,
                Password = registerModel.Password
            });

            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/login?registered=true");
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = RehabTracking.Web.Constants.AppMessages.ErrorOccurred;
            Console.WriteLine(ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private (int Level, string Color, string Label) GetPasswordStrength(string password)
    {
        int score = 0;
        if (password.Length >= 6) score++;
        if (password.Length >= 10) score++;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower)) score++;
        if (password.Any(char.IsDigit) || password.Any(c => !char.IsLetterOrDigit(c))) score++;

        return score switch
        {
            1 => (1, "#ef4444", "Hơi ngắn"),
            2 => (2, "#f59e0b", "Trung bình"),
            3 => (3, "#10b981", "Tốt và an toàn"),
            4 => (4, "#059669", "Rất mạnh và an tâm"),
            _ => (0, "#e2e8f0", "")
        };
    }

    public class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = RehabTracking.Web.Constants.AppMessages.RequiredFullName)]
        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = RehabTracking.Web.Constants.AppMessages.FullNameMaxLength)]
        public string FullName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = RehabTracking.Web.Constants.AppMessages.RequiredEmail)]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = RehabTracking.Web.Constants.AppMessages.InvalidEmail)]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = RehabTracking.Web.Constants.AppMessages.RequiredPassword)]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 6, ErrorMessage = RehabTracking.Web.Constants.AppMessages.PasswordMinLength6)]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = RehabTracking.Web.Constants.AppMessages.RequiredConfirmPassword)]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = RehabTracking.Web.Constants.AppMessages.PasswordsDoNotMatch)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
