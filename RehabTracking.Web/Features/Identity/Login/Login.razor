@page "/login"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Đăng nhập - STEP Phục Hồi Chức Năng</PageTitle>

<div class="py-5" style="min-height: calc(100vh - 120px); background-color: var(--color-bg-app);">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <!-- Tiêu đề trang trọng, ấm áp -->
                <div class="text-center mb-4">
                    <img src="/images/logo/logo.png" alt="STEP Logo" style="height: 68px; width: auto; object-fit: contain;" class="mb-3" />
                    <h1 class="fw-bold text-dark fs-2 mb-2">Đăng Nhập Tài Khoản</h1>
                    <p class="fs-6" style="color: #334155;">Hệ thống theo dõi và hỗ trợ phục hồi chức năng STEP</p>
                </div>

                <!-- Thẻ đăng nhập lớn, viền rõ nét -->
                <div class="senior-card p-4 mb-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="p-3 mb-4 rounded-3 d-flex align-items-center gap-3 border border-danger-subtle bg-danger-subtle text-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-3 flex-shrink-0"></i>
                            <div class="fs-6 fw-bold">@errorMessage</div>
                        </div>
                    }

                    @if (showSuccessMessage)
                    {
                        <div class="p-3 mb-4 rounded-3 d-flex align-items-center gap-3 border border-success-subtle bg-success-subtle text-success" role="alert">
                            <i class="bi bi-check-circle-fill fs-3 flex-shrink-0"></i>
                            <div class="fs-6 fw-bold">@RehabTracking.Web.Constants.AppMessages.RegisterSuccess</div>
                        </div>
                    }

                    <form method="post" action="/api/auth/login">
                        <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                        <!-- Ô nhập Email / Số điện thoại -->
                        <div class="senior-form-group mb-4">
                            <label for="email" class="senior-form-label">
                                <i class="bi bi-envelope-fill text-primary me-2"></i>Địa chỉ Email hoặc Tên đăng nhập
                            </label>
                            <input type="email" id="email" name="Email" class="senior-input"
                                   placeholder="Ví dụ: benhnhan@gmail.com"
                                   value="@demoEmail"
                                   @oninput="e => demoEmail = e.Value?.ToString() ?? string.Empty"
                                   required 
                                   aria-required="true" />
                            <small class="senior-form-hint">Nhập đúng email Bác đã đăng ký với bệnh viện hoặc kỹ thuật viên</small>
                        </div>

                        <!-- Ô nhập Mật khẩu -->
                        <div class="senior-form-group mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="password" class="senior-form-label mb-0">
                                    <i class="bi bi-lock-fill text-primary me-2"></i>Mật khẩu
                                </label>
                                <button type="button" class="btn btn-link text-decoration-none p-0 small" style="color: #475569;"
                                        @onclick="TogglePassword" aria-label="Xem mật khẩu">
                                    <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill") me-1"></i>
                                    @(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")
                                </button>
                            </div>
                            <div class="position-relative">
                                <input type="@(showPassword ? "text" : "password")" id="password" name="Password"
                                       class="senior-input pe-5"
                                       placeholder="Nhập mật khẩu của Bác"
                                       value="@demoPwd"
                                       @oninput="e => demoPwd = e.Value?.ToString() ?? string.Empty"
                                       required 
                                       aria-required="true" />
                            </div>
                        </div>

                        <!-- Nút Đăng nhập to, nổi bật -->
                        <div class="d-grid mt-4 mb-3">
                            <button type="submit" class="senior-btn senior-btn-accent senior-btn-hero w-100">
                                <i class="bi bi-box-arrow-in-right fs-4"></i> ĐĂNG NHẬP VÀO HỆ THỐNG
                            </button>
                        </div>
                    </form>

                    <!-- Trợ giúp người lớn tuổi -->
                    <div class="text-center pt-3 border-top mt-3">
                        <p class="mb-2 fs-6">
                            Bác chưa có tài khoản? 
                            <a href="/register" class="fw-bold" style="color: var(--color-primary);">Đăng ký tài khoản mới</a>
                        </p>
                        <p class="small mb-0" style="color: #475569;">
                            Bác quên mật khẩu hoặc cần hỗ trợ đăng nhập? Gọi ngay 
                            <a href="tel:0787775716" class="text-danger fw-bold text-decoration-none">0787.775.716</a>
                        </p>
                    </div>
                </div>

                <!-- Thẻ tài khoản mẫu để Bác hoặc người nhà thử nghiệm nhanh -->
                <div class="senior-card p-4">
                    <h3 class="fs-6 fw-bold text-center text-uppercase mb-3" style="color: #334155;">
                        <i class="bi bi-person-badge me-2 text-primary"></i>Chọn nhanh tài khoản mẫu để dùng thử
                    </h3>
                    <div class="d-flex flex-column gap-2">
                        <button type="button" class="senior-btn senior-btn-secondary text-start justify-content-start py-2 px-3" 
                                @onclick='() => FillDemo("patient@test.com", "123")'
                                aria-label="Điền thông tin tài khoản Bệnh nhân">
                            <i class="bi bi-person-heart text-success fs-3 me-2"></i>
                            <div>
                                <div class="fw-bold text-dark fs-6">Bệnh nhân phục hồi: <span class="fw-bold" style="color: #15803d;">patient@test.com</span></div>
                                <small style="color: #475569;">Xem bài tập hôm nay, nhật ký cơn đau và bảng vàng</small>
                            </div>
                        </button>

                        <button type="button" class="senior-btn senior-btn-secondary text-start justify-content-start py-2 px-3" 
                                @onclick='() => FillDemo("doctor@test.com", "123")'
                                aria-label="Điền thông tin tài khoản Bác sĩ">
                            <i class="bi bi-heart-pulse-fill text-danger fs-3 me-2"></i>
                            <div>
                                <div class="fw-bold text-dark fs-6">Bác sĩ chuyên khoa: <span class="fw-bold" style="color: #b91c1c;">doctor@test.com</span></div>
                                <small style="color: #475569;">Quản lý bệnh nhân, kê giáo án và phản hồi nhật ký</small>
                            </div>
                        </button>

                        <button type="button" class="senior-btn senior-btn-secondary text-start justify-content-start py-2 px-3" 
                                @onclick='() => FillDemo("admin@test.com", "123")'
                                aria-label="Điền thông tin tài khoản Quản trị viên">
                            <i class="bi bi-shield-lock-fill text-primary fs-3 me-2"></i>
                            <div>
                                <div class="fw-bold text-dark fs-6">Quản trị viên / Kho: <span class="fw-bold" style="color: #1d4ed8;">admin@test.com</span></div>
                                <small style="color: #475569;">Quản lý đơn hàng thiết bị và kiểm toán hệ thống</small>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string errorMessage = string.Empty;
    private bool showSuccessMessage = false;
    private string returnUrl = string.Empty;
    private string demoEmail = string.Empty;
    private string demoPwd = string.Empty;
    private bool showPassword = false;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var error))
        {
            if (error == "InvalidCredentials")
            {
                errorMessage = RehabTracking.Web.Constants.AppMessages.InvalidCredentials;
            }
            else if (error == "AccountLocked")
            {
                errorMessage = RehabTracking.Web.Constants.AppMessages.AccountLocked;
            }
        }
        if (query.TryGetValue("registered", out var reg) && reg == "true")
        {
            showSuccessMessage = true;
        }
        if (query.TryGetValue("returnUrl", out var rUrl))
        {
            returnUrl = rUrl!;
        }
        if (query.TryGetValue("demo_email", out var dEmail))
        {
            demoEmail = dEmail!;
        }
    }

    private void TogglePassword() => showPassword = !showPassword;

    private void FillDemo(string email, string password)
    {
        demoEmail = email;
        demoPwd = password;
    }
}
