@code {
    private int patientId;
    private GamificationProfile? profile;
    private List<RecoveryLog>? recentLogs;
    private RecoveryLog? latestLog;
    private List<RecoveryChartPointDto>? chartData;
    private List<CalendarHeatmapDayDto>? heatmapData;
    private RecoverySummaryStatsDto? summaryStats;
    private List<Exercise>? availableExercises;

    // Modals
    private bool showLogModal = false;
    private bool showDoctorModal = false;
    private bool showReportModal = false;
    private bool isSubmitting = false;

    // Form inputs
    private int newExerciseId = 0;
    private int newPainPreWorkout = 2;
    private int newPainScore = 2;
    private double? newROM = 115;
    private int newFatigue = 2;
    private double newCompletionRate = 100;
    private int newDurationMinutes = 20;
    private double? newSleepHours = 7.5;
    private string newMood = "Tích cực";
    private string newNote = "";

    // Doctor feedback
    private RecoveryLog? feedbackTargetLog;
    private string doctorFeedbackText = "";

    // Report
    private ProgressReportDto? progressReport;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var email = user.FindFirst(ClaimTypes.Email)?.Value;

        if (!string.IsNullOrEmpty(email))
        {
            var dbUser = await Db.Users
                .Include(u => u.PatientProfileUser)
                .FirstOrDefaultAsync(u => u.Email == email);

            if (dbUser != null)
            {
                if (dbUser.PatientProfileUser != null)
                {
                    patientId = dbUser.PatientProfileUser.PatientId;
                }
                else
                {
                    // Fallback nếu là bác sĩ/admin đang test
                    var firstPatient = await Db.PatientProfiles.FirstOrDefaultAsync();
                    patientId = firstPatient?.PatientId ?? 1;
                }
                profile = await GamificationService.GetOrCreateProfileAsync(dbUser.UserId);
            }
        }

        availableExercises = await Db.Exercises.Where(e => e.IsActive).OrderBy(e => e.Title).ToListAsync();

        recentLogs = await Db.RecoveryLogs
            .Where(l => l.PatientId == patientId)
            .Include(l => l.Exercise)
            .Include(l => l.Doctor)
            .OrderByDescending(l => l.LogDate)
            .Take(15)
            .ToListAsync();

        latestLog = recentLogs.FirstOrDefault();
        chartData = await RecoveryService.GetRecoveryChartDataAsync(patientId, 14);
        heatmapData = await RecoveryService.GetCalendarHeatmapDataAsync(patientId, 28);
        summaryStats = await RecoveryService.GetRecoverySummaryStatsAsync(patientId);
    }

    private void OpenLogModal()
    {
        newPainPreWorkout = 2;
        newPainScore = 2;
        newROM = latestLog?.ROMMeasurement ?? 115;
        newFatigue = 2;
        newCompletionRate = 100;
        newDurationMinutes = 20;
        newSleepHours = 7.5;
        newMood = "Tích cực";
        newNote = "";
        showLogModal = true;
    }

    private async Task SubmitRecoveryLog()
    {
        isSubmitting = true;
        try
        {
            await RecoveryService.LogSessionProgressAsync(
                patientId: patientId,
                exerciseId: newExerciseId > 0 ? newExerciseId : null,
                painVAS: newPainScore,
                rom: newROM,
                fatigueLevel: newFatigue,
                completionRate: newCompletionRate,
                durationMinutes: newDurationMinutes,
                note: newNote,
                mediaUrlsJson: null,
                painPreWorkout: newPainPreWorkout,
                sleepHours: newSleepHours,
                moodLevel: newMood
            );

            await AuditService.LogAsync("Ghi_NhatKy_UI", nameof(RecoveryLog), null, patientId, $"Bệnh nhân ghi nhật ký VAS {newPainScore}/10");

            showLogModal = false;
            await LoadDataAsync();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenDoctorFeedbackModal(RecoveryLog log)
    {
        feedbackTargetLog = log;
        doctorFeedbackText = log.DoctorFeedback ?? "";
        showDoctorModal = true;
    }

    private async Task SubmitDoctorFeedback()
    {
        if (feedbackTargetLog != null && !string.IsNullOrWhiteSpace(doctorFeedbackText))
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
            int.TryParse(idClaim?.Value, out int doctorId);

            await RecoveryService.AddDoctorFeedbackAsync(feedbackTargetLog.LogId, doctorId > 0 ? doctorId : 1, doctorFeedbackText);
            await AuditService.LogAsync("NhanXet_BacSi_UI", nameof(RecoveryLog), feedbackTargetLog.LogId.ToString(), patientId, $"Nhận xét: {doctorFeedbackText}");

            showDoctorModal = false;
            await LoadDataAsync();
        }
    }

    private async Task OpenReportModal()
    {
        progressReport = await RecoveryService.GetProgressReportDataAsync(patientId);
        showReportModal = true;
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private static string GetVasBadgeClass(int vas) => vas switch
    {
        <= 3 => "bg-success text-white",
        <= 6 => "bg-warning text-dark",
        _ => "bg-danger text-white"
    };

    private static string GetVasDescription(int vas) => vas switch
    {
        0 => "Không đau",
        1 or 2 => "Đau rất nhẹ",
        3 or 4 => "Đau nhẹ / Khó chịu nhẹ",
        5 or 6 => "Đau vừa phải",
        7 or 8 => "Đau nhiều / Khó chịu",
        _ => "Đau dữ dội / Nguy cấp"
    };

    private static string GetVasBarColor(int vas) => vas switch
    {
        <= 3 => "#10b981",
        <= 6 => "#f59e0b",
        _ => "#ef4444"
    };

    private static string GetFatigueLabel(int level) => level switch
    {
        1 => "Rất nhẹ",
        2 => "Bình thường",
        3 => "Hơi mỏi",
        4 => "Khá mỏi",
        5 => "Kiệt sức",
        _ => "Bình thường"
    };

    private static string GetTierDisplayName(string tier) => tier switch
    {
        "Rookie" => "Tân Binh",
        "Resilient" => "Bền Bỉ",
        "Warrior" => "Chiến Binh",
        "Mastery" => "Phục Hồi Xuất Sắc",
        _ => tier
    };
}
