@page "/patient/recovery-diary"
@page "/recovery-diary"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using RehabTracking.Web.Entities
@using RehabTracking.Web.Services
@using System.Security.Claims
@attribute [Authorize]
@inject RehabTrackingContext Db
@inject RecoveryTrackingService RecoveryService
@inject GamificationService GamificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject AuditService AuditService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Nhật Ký Phục Hồi & Tiến Độ – STEP</PageTitle>

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge rounded-pill px-3 py-1.5 fw-bold mb-2" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                <i class="bi bi-heart-pulse-fill me-1"></i> Theo Dõi Diễn Biến Lâm Sàng
            </span>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-journal-medical text-primary me-2"></i>Nhật Ký Phục Hồi & Tiến Độ
            </h2>
            <p class="text-muted mb-0">Theo dõi mức độ đau (VAS trước/sau), tầm vận động (ROM), giấc ngủ và phản hồi từ Bác sĩ điều trị.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-primary rounded-pill px-3.5 py-2 fw-semibold shadow-sm" @onclick="OpenReportModal">
                <i class="bi bi-printer-fill me-1"></i> Xuất Báo Cáo Y Khoa (PDF)
            </button>
            <button class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" @onclick="OpenLogModal">
                <i class="bi bi-plus-circle-fill me-2"></i> Ghi Nhận Hôm Nay
            </button>
        </div>
    </div>

    <!-- Alert cảnh báo nếu có đau cao -->
    @if (summaryStats?.HighPainSessionsCount > 0)
    {
        <div class="alert alert-warning border-warning-subtle rounded-4 p-3 mb-4 shadow-sm d-flex align-items-center gap-3">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
            <div>
                <strong class="text-dark">Lưu ý an toàn:</strong> Bạn có <strong>@summaryStats.HighPainSessionsCount</strong> buổi tập ghi nhận mức đau cao (VAS &ge; 7). Bác sĩ điều trị đã được thông báo để theo dõi sát sao.
            </div>
        </div>
    }

    <!-- 4 Stats Cards -->
    <div class="row g-3 mb-4">
        <!-- Đau VAS -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white border-start border-4 border-primary">
                <div class="text-muted small fw-semibold">Đau trung bình tuần</div>
                <div class="display-6 fw-bold text-primary my-1">
                    @(summaryStats?.AvgPainCurrentWeek.ToString("0.0") ?? "—") <small class="fs-6 text-muted">/10</small>
                </div>
                <div class="small fw-semibold @(summaryStats?.PainImprovementPercent >= 0 ? "text-success" : "text-danger")">
                    @if (summaryStats?.PainImprovementPercent >= 0)
                    {
                        <span><i class="bi bi-arrow-down-right me-1"></i>Giảm @summaryStats?.PainImprovementPercent% so với tuần trước</span>
                    }
                    else
                    {
                        <span><i class="bi bi-arrow-up-right me-1"></i>Tăng @Math.Abs(summaryStats?.PainImprovementPercent ?? 0)% cần lưu ý</span>
                    }
                </div>
            </div>
        </div>

        <!-- ROM -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white border-start border-4 border-success">
                <div class="text-muted small fw-semibold">Tầm vận động (ROM)</div>
                <div class="display-6 fw-bold text-success my-1">
                    @(summaryStats?.LatestROM > 0 ? $"{summaryStats?.LatestROM}°" : "—")
                </div>
                <div class="small text-success fw-semibold">
                    <i class="bi bi-arrow-up-right me-1"></i>Cải thiện +@(summaryStats?.ROMImprovementDegrees ?? 0)° so với ban đầu
                </div>
            </div>
        </div>

        <!-- Tuân thủ -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white border-start border-4 border-info">
                <div class="text-muted small fw-semibold">Tỷ lệ tuân thủ</div>
                <div class="display-6 fw-bold text-info my-1">
                    @(summaryStats?.ComplianceRate ?? 100)%
                </div>
                <div class="small text-muted">
                    Tổng cộng: <strong>@(summaryStats?.TotalSessions ?? 0)</strong> buổi tập
                </div>
            </div>
        </div>

        <!-- Streak & XP -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white border-start border-4 border-warning">
                <div class="text-muted small fw-semibold">Chuỗi liên tục (Streak)</div>
                <div class="display-6 fw-bold text-danger my-1">
                    <i class="bi bi-fire me-1"></i>@(profile?.CurrentStreak ?? 0) <small class="fs-6 text-muted">ngày</small>
                </div>
                <div class="small text-warning-emphasis fw-semibold">
                    <i class="bi bi-shield-check me-1"></i>@(profile?.StreakShieldCount ?? 1) khiên bảo vệ chuỗi
                </div>
            </div>
        </div>
    </div>

    <!-- Heatmap Lịch Các Ngày Đã Tập -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-calendar-week text-primary me-2"></i>Lịch Hoạt Động & Tính Tuân Thủ (Heatmap)
                </h5>
                <small class="text-muted">Màu đậm thể hiện buổi tập hoàn thành trọn vẹn 100% mục tiêu</small>
            </div>
            <div class="d-flex align-items-center gap-2 small text-muted">
                <span>Ít</span>
                <span class="heatmap-box-legend level-0"></span>
                <span class="heatmap-box-legend level-1"></span>
                <span class="heatmap-box-legend level-2"></span>
                <span class="heatmap-box-legend level-3"></span>
                <span>Nhiều</span>
            </div>
        </div>

        @if (heatmapData != null && heatmapData.Any())
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="Biểu đồ nhiệt chuyên cần 28 ngày qua">
                <div class="d-flex flex-nowrap gap-2 py-2">
                    @foreach (var day in heatmapData)
                    {
                        <div class="d-flex flex-column align-items-center" style="min-width: 32px;" title="@day.Tooltip">
                            <span class="small text-muted mb-1" style="font-size: 0.65rem;">@day.ShortLabel</span>
                            <div class="heatmap-cell level-@day.ColorLevel @(day.Date.Date == DateTime.UtcNow.Date ? "border border-primary border-2" : "")">
                                @if (day.HasWorkout)
                                {
                                    <i class="bi bi-check" style="font-size: 0.8rem; color: white;"></i>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-3 text-muted small">Đang nạp dữ liệu lịch tập...</div>
        }
    </div>

    <!-- Charts Row: Pain Trend & ROM -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ điểm đau VAS (so sánh trước vs sau) -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-graph-down text-success me-2"></i>Xu Hướng Cơn Đau (Thang VAS 0 - 10)
                        </h5>
                        <small class="text-muted">So sánh mức đau trước và sau khi tập</small>
                    </div>
                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Mục tiêu: VAS &le; 2</span>
                </div>

                @if (chartData == null || !chartData.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-bar-chart fs-1 opacity-25"></i>
                        <p class="mt-2 mb-0">Chưa có nhật ký nào được ghi nhận. Hãy bấm "Ghi nhận hôm nay"!</p>
                    </div>
                }
                else
                {
                    <div class="chart-container py-3">
                        <div class="d-flex align-items-end justify-content-between gap-2" style="height: 180px;">
                            @foreach (var pt in chartData)
                            {
                                <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%;">
                                    <div class="small fw-bold mb-1 text-muted" style="font-size: 0.72rem;">@pt.PainScoreVAS</div>
                                    <div class="w-100 rounded-top transition-all" 
                                         style="height: @(Math.Max(pt.PainScoreVAS * 10, 8))%; max-width: 28px; background: @GetVasBarColor(pt.PainScoreVAS);"
                                         title="Ngày @pt.DateLabel: Trước tập: @pt.PainPreWorkout/10 • Sau tập: @pt.PainScoreVAS/10"></div>
                                    <span class="small text-muted mt-2" style="font-size: 0.68rem;">@pt.DateLabel</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="d-flex justify-content-center gap-4 pt-2 border-top small text-muted">
                        <span><i class="bi bi-circle-fill text-success me-1"></i>0-3: An toàn / Nhẹ</span>
                        <span><i class="bi bi-circle-fill text-warning me-1"></i>4-6: Vừa phải</span>
                        <span><i class="bi bi-circle-fill text-danger me-1"></i>7-10: Cần dừng tập</span>
                    </div>
                }
            </div>
        </div>

        <!-- Biểu đồ ROM & Giấc ngủ -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <h5 class="fw-bold text-dark mb-1">
                    <i class="bi bi-speedometer2 text-primary me-2"></i>Biên Độ ROM & Thể Trạng
                </h5>
                <p class="text-muted small mb-3">Tầm vận động khớp và chỉ số giấc ngủ phục hồi</p>

                <div class="p-3 bg-light rounded-3 mb-3 text-center">
                    <span class="text-muted small d-block">Biên độ đo được gần nhất</span>
                    <span class="display-6 fw-bold text-primary">
                        @(latestLog?.ROMMeasurement.HasValue == true ? $"{latestLog.ROMMeasurement}°" : "—")
                    </span>
                    <div class="text-success small fw-semibold mt-1">
                        <i class="bi bi-arrow-up-right me-1"></i> Cải thiện +@(summaryStats?.ROMImprovementDegrees ?? 0)° so với tuần đầu
                    </div>
                </div>

                <div class="row g-2 text-center">
                    <div class="col-6">
                        <div class="border rounded-3 p-3">
                            <span class="text-muted small d-block">Giấc ngủ trung bình</span>
                            <span class="fs-5 fw-bold text-dark">
                                @(latestLog?.SleepHours.HasValue == true ? $"{latestLog.SleepHours}h/đêm" : "7.5h/đêm")
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded-3 p-3">
                            <span class="text-muted small d-block">Tâm trạng gần nhất</span>
                            <span class="fs-5 fw-bold text-primary">
                                @(latestLog?.MoodLevel ?? "Tích cực")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- History Log Table with Doctor Feedback -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-clock-history text-primary me-2"></i>Lịch Sử Ghi Nhận Chi Tiết
            </h5>
            <span class="text-muted small">Hiển thị @(recentLogs?.Count ?? 0) bản ghi gần nhất</span>
        </div>

        <div class="table-responsive" tabindex="0" role="region" aria-label="Bảng lịch sử ghi nhận chi tiết">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ngày tập</th>
                        <th>Bài tập liên kết</th>
                        <th>Đau trước / sau</th>
                        <th>Biên độ (ROM)</th>
                        <th>Mệt mỏi / Ngủ</th>
                        <th>Cảm nhận bệnh nhân</th>
                        <th>Chỉ đạo của Bác sĩ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentLogs == null || !recentLogs.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Chưa có nhật ký nào được ghi nhận. Hãy ghi nhận buổi tập đầu tiên của bạn!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in recentLogs)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark text-nowrap">
                                    @log.LogDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @if (log.Exercise != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1">
                                            @log.Exercise.Title
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">
                                            Tập theo phác đồ ngày
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-light text-secondary border">Trước: @log.PainPreWorkout</span>
                                        <i class="bi bi-arrow-right text-muted small"></i>
                                        <span class="badge @GetVasBadgeClass(log.PainScoreVAS) rounded-pill px-2.5 py-1">
                                            Sau: @log.PainScoreVAS/10
                                        </span>
                                    </div>
                                </td>
                                <td class="fw-semibold text-primary">
                                    @(log.ROMMeasurement.HasValue ? $"{log.ROMMeasurement}°" : "—")
                                </td>
                                <td class="small text-muted">
                                    <div>Mệt: @GetFatigueLabel(log.FatigueLevel)</div>
                                    @if (log.SleepHours.HasValue)
                                    {
                                        <div>Ngủ: @log.SleepHours.Value h</div>
                                    }
                                </td>
                                <td class="small text-secondary" style="max-width: 200px;">
                                    @if (!string.IsNullOrEmpty(log.MoodLevel))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill me-1">@log.MoodLevel</span>
                                    }
                                    <span>@(string.IsNullOrEmpty(log.PatientNote) ? "—" : log.PatientNote)</span>
                                </td>
                                <td class="small" style="max-width: 240px;">
                                    @if (!string.IsNullOrEmpty(log.DoctorFeedback))
                                    {
                                        <div class="p-2 bg-success-subtle text-success-emphasis rounded-3 border border-success-subtle">
                                            <i class="bi bi-chat-quote-fill me-1"></i> @log.DoctorFeedback
                                        </div>
                                    }
                                    else
                                    {
                                        <AuthorizeView Roles="Doctor,Admin">
                                            <button class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5" @onclick="() => OpenDoctorFeedbackModal(log)">
                                                <i class="bi bi-reply-fill me-1"></i> Nhận xét
                                            </button>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="Patient">
                                            <span class="text-muted fst-italic">Bác sĩ đang theo dõi</span>
                                        </AuthorizeView>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Ghi Nhận Nhật Ký Mới -->
@if (showLogModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1050;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg p-3">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Ghi Nhận Buổi Tập & Trạng Thái Phục Hồi
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showLogModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Bài tập hoàn thành trong ngày</label>
                            <select class="form-select rounded-3" @bind="newExerciseId">
                                <option value="0">Tập tổng hợp theo phác đồ</option>
                                @if (availableExercises != null)
                                {
                                    @foreach (var ex in availableExercises)
                                    {
                                        <option value="@ex.ExerciseId">@ex.Title (@ex.TargetArea)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Thời gian tập thực tế (phút)</label>
                            <input type="number" class="form-control rounded-3" min="5" max="180" @bind="newDurationMinutes" />
                        </div>

                        <!-- Đau trước tập -->
                        <div class="col-12">
                            <label class="senior-form-label">
                                <i class="bi bi-heart-pulse text-primary me-2"></i>1. Mức độ đau TRƯỚC khi tập:
                            </label>
                            <SeniorPainScale @bind-Value="newPainPreWorkout" />
                        </div>

                        <!-- Đau sau tập -->
                        <div class="col-12 mt-3">
                            <label class="senior-form-label">
                                <i class="bi bi-heart-pulse-fill text-danger me-2"></i>2. Mức độ đau SAU khi tập xong:
                            </label>
                            <SeniorPainScale @bind-Value="newPainScore" />
                        </div>

                        <!-- ROM & Mệt mỏi -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Biên độ góc ROM đo được (°)</label>
                            <input type="number" class="form-control rounded-3" min="0" max="180" @bind="newROM" placeholder="Ví dụ: 110" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Giấc ngủ đêm qua (giờ)</label>
                            <input type="number" step="0.5" class="form-control rounded-3" min="3" max="14" @bind="newSleepHours" placeholder="Ví dụ: 7.5" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Mức độ mệt mỏi</label>
                            <select class="form-select rounded-3" @bind="newFatigue">
                                <option value="1">1 - Rất nhẹ, sảng khoái</option>
                                <option value="2">2 - Bình thường, vừa sức</option>
                                <option value="3">3 - Hơi mỏi cơ</option>
                                <option value="4">4 - Khá kiệt sức</option>
                                <option value="5">5 - Đau mỏi quá mức</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Tâm trạng hôm nay</label>
                            <select class="form-select rounded-3" @bind="newMood">
                                <option value="Vui vẻ">Vui vẻ, lạc quan</option>
                                <option value="Tích cực">Tích cực, có động lực</option>
                                <option value="Bình thường">Bình thường</option>
                                <option value="Mệt mỏi">Mệt mỏi, uể oải</option>
                                <option value="Lo lắng">Lo lắng về cơn đau</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Tỷ lệ hoàn thành (%)</label>
                            <input type="number" class="form-control rounded-3" min="10" max="100" @bind="newCompletionRate" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Ghi chú chi tiết cho Bác sĩ</label>
                            <textarea class="form-control rounded-3" rows="3" placeholder="Ví dụ: Cảm giác khớp gối không còn kêu lục cục, nhưng cơ đùi sau hơi căng cứng..." @bind="newNote"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => showLogModal = false">Hủy</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="SubmitRecoveryLog" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-check-circle-fill me-1"></i> Lưu & Nhận Điểm XP
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Bác Sĩ Để Lại Nhận Xét -->
@if (showDoctorModal && feedbackTargetLog != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg p-3">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-chat-quote-fill text-primary me-2"></i>Chỉ Đạo Chuyên Môn Của Bác Sĩ
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showDoctorModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="p-3 bg-light rounded-3 mb-3 small">
                        <div><strong>Ngày tập:</strong> @feedbackTargetLog.LogDate.ToString("dd/MM/yyyy HH:mm")</div>
                        <div><strong>Điểm đau:</strong> Trước: @feedbackTargetLog.PainPreWorkout/10 • Sau: @feedbackTargetLog.PainScoreVAS/10</div>
                        <div><strong>Ghi chú bệnh nhân:</strong> @(feedbackTargetLog.PatientNote ?? "Không có")</div>
                    </div>
                    <label class="form-label fw-semibold small">Lời khuyên / Điều chỉnh phác đồ:</label>
                    <textarea class="form-control rounded-3" rows="3" @bind="doctorFeedbackText" placeholder="Ví dụ: Giữ nguyên tiến độ, chườm lạnh sau tập 15 phút, buổi sau nâng ROM thêm 5 độ..."></textarea>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => showDoctorModal = false">Hủy</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="SubmitDoctorFeedback">
                        <i class="bi bi-send-fill me-1"></i> Gửi Chỉ Đạo
                    </button>
                </div>
            </div>
        </div>
    </div>
}

