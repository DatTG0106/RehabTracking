</style>

@code {
    private bool isLoading = true;
    private bool isDoctorOrAdmin = false;
    private int currentUserId = 0;
    private string currentUserRole = "Patient";
    private int selectedPatientId = 0;
    private string activeTab = "ClinicalRecord"; // "ClinicalRecord", "Timeline", "AuditLog"

    private string alertMessage = string.Empty;
    private bool isSuccessAlert = true;

    private PatientProfile? currentPatient;
    private ElectronicHealthRecord? ehr;
    private List<PatientProfile> allPatients = new();
    private List<DiagnosticImageDto> diagnosticImages = new();

    // Timeline state
    private List<RecoveryTimelineEventDto> timelineEvents = new();
    private bool isLoadingTimeline = false;

    // Audit logs state
    private List<AuditLog> auditLogs = new();
    private bool isLoadingAuditLogs = false;

    // Modal state
    private DiagnosticImageDto? activePreviewImage = null;
    private bool showEditEhrModal = false;
    private UpdateEhrRequest editEhrForm = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var roleClaim = user.FindFirst(ClaimTypes.Role)?.Value;
            currentUserRole = roleClaim ?? "Patient";
            isDoctorOrAdmin = currentUserRole == "Doctor" || currentUserRole == "Admin";

            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            int.TryParse(idClaim, out currentUserId);
        }

        await LoadPatientAndEhrData();
    }

    private async Task LoadPatientAndEhrData()
    {
        isLoading = true;
        try
        {
            if (isDoctorOrAdmin)
            {
                allPatients = await Db.PatientProfiles
                    .Include(p => p.User)
                    .OrderBy(p => p.User.FullName)
                    .ToListAsync();

                if (selectedPatientId == 0 && allPatients.Count > 0)
                {
                    selectedPatientId = allPatients[0].PatientId;
                }

                currentPatient = allPatients.FirstOrDefault(p => p.PatientId == selectedPatientId);
            }
            else
            {
                currentPatient = await Db.PatientProfiles
                    .Include(p => p.User)
                    .Include(p => p.Doctor)
                    .FirstOrDefaultAsync(p => p.UserId == currentUserId);

                if (currentPatient != null)
                {
                    selectedPatientId = currentPatient.PatientId;
                }
            }

            if (selectedPatientId > 0)
            {
                ehr = await EhrService.GetEhrByPatientIdAsync(selectedPatientId, currentUserId, currentUserRole);
                if (ehr != null && !string.IsNullOrEmpty(ehr.DiagnosticImagingJson))
                {
                    try
                    {
                        diagnosticImages = JsonSerializer.Deserialize<List<DiagnosticImageDto>>(ehr.DiagnosticImagingJson) ?? new();
                    }
                    catch
                    {
                        diagnosticImages = new();
                    }
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPatientSelectionChanged()
    {
        currentPatient = allPatients.FirstOrDefault(p => p.PatientId == selectedPatientId);
        await LoadPatientAndEhrData();
        if (activeTab == "Timeline") await LoadTimeline();
        if (activeTab == "AuditLog") await LoadAuditLogs();
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == "Timeline" && timelineEvents.Count == 0)
        {
            await LoadTimeline();
        }
        else if (tab == "AuditLog" && auditLogs.Count == 0)
        {
            await LoadAuditLogs();
        }
    }

    private async Task LoadTimeline()
    {
        if (selectedPatientId <= 0) return;
        isLoadingTimeline = true;
        try
        {
            timelineEvents = await EhrService.GetRecoveryTimelineAsync(selectedPatientId);
        }
        finally
        {
            isLoadingTimeline = false;
        }
    }

    private async Task LoadAuditLogs()
    {
        if (selectedPatientId <= 0) return;
        isLoadingAuditLogs = true;
        try
        {
            auditLogs = await Db.AuditLogs
                .AsNoTracking()
                .Include(a => a.User)
                .Where(a => a.TargetPatientId == selectedPatientId || a.EntityName == "ElectronicHealthRecord")
                .OrderByDescending(a => a.Timestamp)
                .Take(40)
                .ToListAsync();
        }
        finally
        {
            isLoadingAuditLogs = false;
        }
    }

    private void OpenImagePreview(DiagnosticImageDto img)
    {
        activePreviewImage = img;
    }

    private void OpenEditEhrModal()
    {
        if (ehr == null) return;
        editEhrForm = new UpdateEhrRequest
        {
            RecordId = ehr.RecordId,
            PatientId = ehr.PatientId,
            InitialDiagnosis = ehr.InitialDiagnosis,
            AffectedAnatomy = ehr.AffectedAnatomy,
            MedicalHistory = ehr.MedicalHistory,
            Contraindications = ehr.Contraindications,
            TreatmentGoals = ehr.TreatmentGoals,
            DiagnosticImages = diagnosticImages
        };
        showEditEhrModal = true;
    }

    private async Task SaveEhrRecord()
    {
        if (string.IsNullOrWhiteSpace(editEhrForm.InitialDiagnosis) || string.IsNullOrWhiteSpace(editEhrForm.AffectedAnatomy))
        {
            alertMessage = "Vui lòng nhập đầy đủ Chẩn đoán xác định và Vùng giải phẫu tổn thương.";
            isSuccessAlert = false;
            return;
        }

        ehr = await EhrService.UpdateEhrAsync(editEhrForm, currentUserId, currentUserRole);
        alertMessage = "Cập nhật hồ sơ bệnh án điện tử thành công! Đã ghi vết kiểm toán.";
        isSuccessAlert = true;
        showEditEhrModal = false;
        await LoadPatientAndEhrData();
        if (activeTab == "AuditLog") await LoadAuditLogs();
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private static string GetRoleBadgeClass(string role) => role switch
    {
        "Doctor" => "bg-danger text-white",
        "Admin" => "bg-primary text-white",
        "Patient" => "bg-success text-white",
        _ => "bg-secondary text-white"
    };
}
