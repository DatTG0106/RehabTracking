@page "/patient-dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Patient")]
@using MediatR
@using RehabTracking.Web.Entities
@using RehabTracking.Web.Features.Healthcare.PatientDashboard
@using Microsoft.AspNetCore.SignalR.Client
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Radzen.Blazor
@using RehabTracking.Web.Constants
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Bảng Sức Khỏe Của Bác - STEP</PageTitle>

<div class="py-4" style="background-color: var(--color-bg-app); min-height: 100vh;">
    <div class="container py-2">
        @if (isLoading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5" style="min-height: 50vh;">
                <div class="spinner-border text-success mb-3" style="width: 3.5rem; height: 3.5rem;" role="status"></div>
                <h4 class="fw-bold text-dark">Đang tải dữ liệu sức khỏe của Bác...</h4>
                <p class="text-muted">Bác vui lòng chờ trong giây lát nhé ạ.</p>
            </div>
        }
        else if (!hasPatientProfile)
        {
            <!-- Chưa kích hoạt thiết bị -->
            <div class="row justify-content-center">
                <div class="col-md-9 col-lg-7">
                    <div class="senior-card p-5 text-center">
                        <div class="mb-4">
                            <div class="rounded-circle d-inline-flex justify-content-center align-items-center" 
                                 style="width:110px;height:110px; background-color: var(--color-status-warning-bg); border: 2px solid #FDE68A;">
                                <i class="bi bi-watch text-warning fs-1" style="font-size:3.5rem !important;"></i>
                            </div>
                        </div>
                        <h2 class="fw-bold text-dark mb-3">Kính chào Bác @patientName!</h2>
                        <p class="text-muted fs-5 mb-4" style="line-height: 1.7;">
                            Bác chưa kích hoạt vòng đeo tay thông minh RehabBand. Bác hãy bấm nút bên dưới để kết nối thiết bị và bắt đầu hành trình phục hồi an toàn nhé!
                        </p>
                        <a href="/activate-device" class="senior-btn senior-btn-accent senior-btn-hero shadow">
                            <i class="bi bi-qr-code-scan fs-4"></i> KÍCH HOẠT THIẾT BỊ NGAY
                        </a>
                        <div class="mt-4 p-3 bg-light rounded-3 text-muted small border">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            Mã kích hoạt gồm 8 số in rõ ở mặt sau vòng tay hoặc trên phiếu khám bệnh.
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Lời chào đầu ngày ấm áp -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <span class="senior-badge senior-badge-success mb-2">
                        <i class="bi bi-shield-check"></i> Hồ sơ y tế đang được Bác sĩ theo dõi
                    </span>
                    <h1 class="fw-bold mb-1" style="font-size: 2.2rem; color: var(--color-text-main);">
                        Kính chào Bác <span style="color: var(--color-primary);">@patientName</span>! 🌿
                    </h1>
                    <p class="text-muted fs-5 mb-0">
                        Chúc Bác một ngày thật nhiều niềm vui, vận động nhẹ nhàng và an tâm!
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="/patient/recovery-diary" class="senior-btn senior-btn-secondary" title="Ghi lại mức độ đau hôm nay">
                        <i class="bi bi-journal-medical fs-5 text-primary"></i> Ghi Nhật Ký
                    </a>
                    <a href="/patient/appointments" class="senior-btn senior-btn-secondary" title="Xem lịch hẹn với Bác sĩ">
                        <i class="bi bi-calendar2-heart fs-5 text-danger"></i> Lịch Hẹn Bác Sĩ
                    </a>
                </div>
            </div>

            <!-- 1. KHỐI TIÊU ĐIỂM: VIỆC CẦN LÀM HÔM NAY (DAILY FOCUS CARD) -->
            <div class="senior-daily-focus mb-4">
                <div class="row align-items-center justify-content-between g-4">
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-warning text-dark fs-6 px-3 py-1 rounded-pill fw-bold">
                                <i class="bi bi-star-fill me-1"></i> NHIỆM VỤ QUAN TRỌNG HÔM NAY
                            </span>
                            @if (treatmentPlan != null)
                            {
                                <span class="text-muted small">Phác đồ: @treatmentPlan.Title</span>
                            }
                        </div>
                        <h2 class="fw-bold text-dark fs-1 mb-2">
                            @(treatmentPlan?.Title ?? "Bài tập phục hồi khớp gối & cổ chân")
                        </h2>
                        <p class="text-muted fs-5 mb-3" style="line-height: 1.6;">
                            @if (!string.IsNullOrWhiteSpace(parsedDoctorNotes))
                            {
                                <span><strong>Lời dặn của Bác sĩ:</strong> "@parsedDoctorNotes"</span>
                            }
                            else
                            {
                                <span>Mục tiêu hôm nay: Vận động nhẹ nhàng <strong>@(treatmentPlan?.TargetDuration ?? 15) phút</strong>, thực hiện đúng tầm vận động khớp để duy trì độ dẻo dai.</span>
                            }
                        </p>

                        <div class="d-flex align-items-center gap-4 flex-wrap">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-clock-history fs-4 text-primary"></i>
                                <span class="fs-5">Thời gian: <strong>@(treatmentPlan?.TargetDuration ?? 15) phút</strong></span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-arrow-repeat fs-4 text-success"></i>
                                <span class="fs-5">Số lần gập duỗi: <strong>@(treatmentPlan?.TargetRepetitions ?? 20) lần</strong></span>
                            </div>
                        </div>
                    </div>

                    <!-- Nút Bắt đầu tập lớn -->
                    <div class="col-lg-4 text-lg-end">
                        @if (!isExercising)
                        {
                            <a href="/patient/workout" class="senior-btn senior-btn-accent senior-btn-hero w-100 w-lg-auto shadow">
                                <i class="bi bi-play-circle-fill fs-3"></i> BẮT ĐẦU TẬP NGAY
                            </a>
                        }
                        else
                        {
                            <div class="p-3 bg-white rounded-4 border border-danger text-center">
                                <div class="text-danger fw-bold fs-4 mb-2">
                                    <i class="bi bi-stopwatch fs-4 me-1"></i> Đang tập: @FormatElapsedTime()
                                </div>
                                <button class="senior-btn btn-danger w-100" @onclick="StopSession" disabled="@isSavingSession">
                                    @if (isSavingSession)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Đang lưu...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-stop-circle fs-4 me-1"></i> <strong>HOÀN THÀNH & LƯU</strong>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Thông báo lưu phiên tập thành công -->
            @if (!string.IsNullOrEmpty(sessionSavedMsg))
            {
                <div class="p-3 mb-4 rounded-3 d-flex align-items-center gap-3 border @(sessionSavedSuccess ? "border-success bg-success-subtle text-success" : "border-warning bg-warning-subtle text-dark")">
                    <i class="bi @(sessionSavedSuccess ? "bi-check-circle-fill fs-3" : "bi-exclamation-circle-fill fs-3")"></i>
                    <div class="fs-6 fw-bold">@sessionSavedMsg</div>
                    <button type="button" class="btn-close ms-auto" @onclick="() => sessionSavedMsg = string.Empty"></button>
                </div>
            }

            <!-- Thiết bị đang kết nối phát sóng trực tiếp -->
            @if (isExercising)
            {
                <div class="senior-card p-4 mb-4 border-2 border-success" style="background-color: var(--color-status-success-bg);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="spinner-grow text-success" role="status" style="width: 2rem; height: 2rem;"></div>
                        <div>
                            <h4 class="fw-bold text-success mb-1">Vòng tay RehabBand đang hoạt động tốt</h4>
                            <p class="text-muted mb-0 fs-6">Đang đo và truyền góc gập khớp trực tiếp đến hồ sơ theo dõi của Bác sĩ.</p>
                        </div>
                        <div class="ms-auto text-end">
                            <div class="fs-1 fw-bold text-success">@(liveData.LastOrDefault()?.ROMValue.ToString("0") ?? "0")°</div>
                            <div class="text-muted small fw-bold">Góc gập khớp hiện tại</div>
                        </div>
                    </div>
                </div>
            }

            <!-- 2. BA THẺ CHỈ SỐ TIẾN BỘ LỚN TRONG NGÀY -->
            <div class="row g-4 mb-4">
                <!-- Thẻ 1: Thời gian tập hôm nay -->
                <div class="col-md-4">
                    <div class="senior-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-6 fw-bold text-muted text-uppercase">Thời gian tập hôm nay</span>
                            <div class="p-2 rounded-circle bg-light text-primary">
                                <i class="bi bi-clock-history fs-4"></i>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span class="fw-bold text-dark" style="font-size: 3rem; line-height: 1;">@todayDuration</span>
                            <span class="fs-5 text-muted fw-bold">phút</span>
                        </div>
                        <div class="senior-progress mb-2">
                            <div class="senior-progress-bar" style="width: @(Math.Min(todayDuration * 100 / Math.Max(treatmentPlan?.TargetDuration ?? 30, 1), 100))%;"></div>
                        </div>
                        <div class="text-muted small">
                            Mục tiêu của Bác sĩ: <strong>@(treatmentPlan?.TargetDuration ?? 30) phút/ngày</strong>
                        </div>
                    </div>
                </div>

                <!-- Thẻ 2: Số lần gập duỗi hợp lệ -->
                <div class="col-md-4">
                    <div class="senior-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-6 fw-bold text-muted text-uppercase">Số lần vận động khớp</span>
                            <div class="p-2 rounded-circle bg-light text-success">
                                <i class="bi bi-arrow-repeat fs-4"></i>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span class="fw-bold text-success" style="font-size: 3rem; line-height: 1;">@todayReps</span>
                            <span class="fs-5 text-muted fw-bold">lần</span>
                        </div>
                        <div class="senior-progress mb-2">
                            <div class="senior-progress-bar bg-success" style="width: @(Math.Min(todayReps * 100 / Math.Max(treatmentPlan?.TargetRepetitions ?? 30, 1), 100))%;"></div>
                        </div>
                        <div class="text-muted small">
                            Mục tiêu của Bác sĩ: <strong>@(treatmentPlan?.TargetRepetitions ?? 30) lần/ngày</strong>
                        </div>
                    </div>
                </div>

                <!-- Thẻ 3: Điểm tiến bộ phục hồi -->
                <div class="col-md-4">
                    <div class="senior-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fs-6 fw-bold text-muted text-uppercase">Đánh giá tiến bộ</span>
                            <div class="p-2 rounded-circle bg-light text-info">
                                <i class="bi bi-award-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span class="fw-bold text-info" style="font-size: 3rem; line-height: 1;">@recoveryScore</span>
                            <span class="fs-5 text-muted fw-bold">%</span>
                        </div>
                        <div class="senior-progress mb-2">
                            <div class="senior-progress-bar bg-info" style="width: @recoveryScore%;"></div>
                        </div>
                        <div class="fs-6 fw-bold">
                            @if (recoveryScore >= 80)
                            {
                                <span class="text-success"><i class="bi bi-emoji-laughing-fill me-1"></i> Rất xuất sắc! Khớp gối hồi phục rất tốt.</span>
                            }
                            else if (recoveryScore >= 50)
                            {
                                <span class="text-primary"><i class="bi bi-emoji-smile-fill me-1"></i> Khá tốt! Bác hãy tiếp tục duy trì nhé.</span>
                            }
                            else
                            {
                                <span class="text-muted"><i class="bi bi-heart-fill text-danger me-1"></i> Bác hãy tập đều đặn mỗi ngày nhé ạ.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. CHUỖI NGÀY KIÊN TRÌ CỦA BÁC & BÁC SĨ PHỤ TRÁCH -->
            <div class="row g-4 mb-4">
                <!-- Chuỗi ngày kiên trì (Warm Light Theme) -->
                <div class="col-lg-7">
                    <div class="senior-card h-100" style="background-color: var(--color-accent-surface); border-color: var(--color-accent-light);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="senior-card-title fs-4" style="color: var(--color-accent);">
                                <i class="bi bi-stars fs-3"></i> Chuỗi Ngày Kiên Trì Của Bác
                            </h3>
                            <span class="badge rounded-pill bg-white text-dark px-3 py-2 fs-6 fw-bold border">
                                @CalculateStreak() ngày liên tục 🎉
                            </span>
                        </div>

                        <p class="text-muted fs-6 mb-4">
                            Mỗi ngày tập luyện là một bước tiến quan trọng giúp các khớp vận động linh hoạt hơn. Bác hãy cùng giữ vững chuỗi ngày kiên trì này nhé!
                        </p>

                        <!-- Vòng tròn 7 ngày trong tuần trực quan -->
                        <div class="d-flex justify-content-between align-items-center text-center p-3 bg-white rounded-4 border mb-3">
                            @for (int i = 6; i >= 0; i--)
                            {
                                var checkDay = DateTime.UtcNow.AddDays(-i);
                                var hasDone = sessions.Any(s => s.StartTime.Date == checkDay.Date);
                                var isTodayDay = i == 0;
                                <div class="d-flex flex-column align-items-center">
                                    <span class="small text-muted mb-1 fw-bold">@(checkDay.DayOfWeek == DayOfWeek.Sunday ? "CN" : "T" + ((int)checkDay.DayOfWeek + 1))</span>
                                    <div class="rounded-circle d-flex align-items-center justify-content-center border"
                                         style="width: 44px; height: 44px; background-color: @(hasDone ? "var(--color-status-success-bg)" : "#F5F5F0"); border-color: @(hasDone ? "var(--color-status-success)" : "#D6D3D1") !important;">
                                        @if (hasDone)
                                        {
                                            <i class="bi bi-check-lg text-success fs-4 fw-bold"></i>
                                        }
                                        else if (isTodayDay)
                                        {
                                            <i class="bi bi-circle-fill text-warning fs-6"></i>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@checkDay.Day</span>
                                        }
                                    </div>
                                    <span class="small mt-1 @(isTodayDay ? "fw-bold text-dark" : "text-muted")">
                                        @(isTodayDay ? "Hôm nay" : checkDay.Day + "/" + checkDay.Month)
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="d-flex align-items-center justify-content-between bg-white p-3 rounded-4 border">
                            <div>
                                <span class="text-muted small">Cấp bậc kiên trì:</span>
                                <div class="fw-bold fs-5" style="color: var(--color-primary);">@GetRankName(GetRankTier(CalculatePoints()))</div>
                            </div>
                            <a href="/patient/ranking" class="senior-btn senior-btn-secondary py-2 px-3 fs-6">
                                <i class="bi bi-trophy-fill text-warning"></i> Xem Bảng Vàng
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Bác sĩ chuyên khoa phụ trách -->
                <div class="col-lg-5">
                    <div class="senior-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="senior-card-header mb-3">
                                <h3 class="senior-card-title fs-5">
                                    <i class="bi bi-person-heart text-danger"></i> Bác Sĩ Cố Vấn Của Bác
                                </h3>
                                <span class="senior-badge senior-badge-success">Đang trực tuyến</span>
                            </div>

                            <div class="d-flex align-items-center gap-3 mb-4">
                                <img src="/images/bsiAn.jpg" alt="Bác sĩ điều trị" class="rounded-circle border" 
                                     style="width: 72px; height: 72px; object-fit: cover; border-width: 3px !important; border-color: var(--color-primary) !important;" />
                                <div>
                                    <h4 class="fw-bold text-dark mb-1">BS. CKII. Trần Minh Khoa</h4>
                                    <p class="text-muted small mb-0">Chuyên khoa Phục hồi chức năng & Vật lý trị liệu</p>
                                    <span class="badge bg-light text-dark border mt-1">Bệnh viện Hoàn Mỹ</span>
                                </div>
                            </div>

                            <div class="p-3 rounded-3 mb-3 bg-light border">
                                <div class="text-muted small fw-bold mb-1">
                                    <i class="bi bi-chat-quote-fill text-primary me-1"></i> Lời dặn từ Bác sĩ:
                                </div>
                                <p class="mb-0 fs-6" style="line-height: 1.5;">
                                    "Bác nhớ khởi động xoay khớp nhẹ nhàng trước khi tập và uống một ly nước ấm sau khi hoàn thành bài tập nhé ạ!"
                                </p>
                            </div>
                        </div>

                        <!-- Các nút liên hệ nhanh to rõ -->
                        <div class="d-grid gap-2">
                            <a href="tel:0787775716" class="senior-btn senior-btn-primary">
                                <i class="bi bi-telephone-fill"></i> Gọi Điện Cho Bác Sĩ (0787.775.716)
                            </a>
                            <a href="https://zalo.me/0787775716" target="_blank" class="senior-btn senior-btn-secondary">
                                <img src="https://page.widget.zalo.me/static/images/2.0/Logo.svg" style="width: 22px; height: 22px;" alt="Zalo" />
                                Nhắn Tin Zalo Với Bác Sĩ
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. LỊCH SỬ TẬP LUYỆN 10 BUỔI GẦN NHẤT -->
            <div class="senior-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h3 class="senior-card-title fs-4">
                        <i class="bi bi-clock-history text-primary"></i> Lịch Sử Tập Luyện Gần Đây
                    </h3>
                    <span class="badge rounded-pill bg-light text-dark border px-3 py-2 fs-6">
                        Tổng cộng: @sessions.Count buổi tập
                    </span>
                </div>

                @if (sessions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 1.05rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="py-3 ps-3">Ngày & Giờ tập</th>
                                    <th class="py-3">Thời gian</th>
                                    <th class="py-3">Số lần co duỗi</th>
                                    <th class="py-3">Góc gập khớp tối đa</th>
                                    <th class="py-3 pe-3 text-end">Đánh giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in sessions.Take(7))
                                {
                                    <tr>
                                        <td class="py-3 ps-3 fw-bold text-dark">
                                            <i class="bi bi-calendar-check text-success me-2"></i>
                                            @session.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="py-3 text-muted">@session.DurationMinutes phút</td>
                                        <td class="py-3 fw-bold" style="color: var(--color-primary);">@session.RepetitionsCount lần</td>
                                        <td class="py-3 text-muted">@session.MaxRom°</td>
                                        <td class="py-3 pe-3 text-end">
                                            @if (session.RepetitionsCount >= (treatmentPlan?.TargetRepetitions ?? 10))
                                            {
                                                <span class="senior-badge senior-badge-success">
                                                    <i class="bi bi-check-circle-fill"></i> Hoàn thành tốt
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="senior-badge senior-badge-warning">
                                                    <i class="bi bi-star-half"></i> Đã cố gắng
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-plus fs-1 text-muted mb-2 d-block"></i>
                        <p class="fs-5 mb-0">Bác chưa có buổi tập nào được ghi lại. Hãy bắt đầu buổi tập đầu tiên hôm nay nhé!</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<ExerciseSession> sessions = new();
    private List<ExerciseSession> todaySessions = new();
    private TreatmentPlan? treatmentPlan;
    private bool isExercising = false;
    private bool isLoading = true;
    private bool isSavingSession = false;
    private bool hasPatientProfile = false;
    private int patientId = 0;
    private string patientName = "Bác";
    private double currentEMG = 0;
    private string sessionSavedMsg = string.Empty;
    private bool sessionSavedSuccess = false;
    private string parsedDoctorNotes = string.Empty;

    private int todayDuration => todaySessions.Sum(s => s.DurationMinutes);
    private int todayReps => todaySessions.Sum(s => s.RepetitionsCount);

    private int _recoveryScore = 0;
    private int recoveryScore => _recoveryScore;

    private void RecalculateRecoveryScore()
    {
        if (!sessions.Any()) { _recoveryScore = 0; return; }
        var targetReps = treatmentPlan?.TargetRepetitions ?? 30;
        var recentSessions = sessions.OrderByDescending(s => s.StartTime).Take(7).ToList();
        if (!recentSessions.Any()) { _recoveryScore = 0; return; }
        var avgReps = recentSessions.Average(s => s.RepetitionsCount);
        _recoveryScore = (int)Math.Min((avgReps / Math.Max(targetReps, 1)) * 100, 100);
    }

    private DateTime sessionStartTime;
    private CancellationTokenSource? _timerCts;

    private HubConnection? hubConnection;
    private List<ChartDataPoint> liveData = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);

        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            patientId = userId;
        }

        patientName = user.Identity?.Name ?? "Bác";

        try
        {
            var result = await Mediator.Send(new GetPatientProgressQuery { PatientId = patientId });
            sessions = result.Sessions;
            treatmentPlan = result.TreatmentPlan;
            hasPatientProfile = result.HasPatientProfile;
            todaySessions = sessions.Where(s => s.StartTime.Date == DateTime.UtcNow.Date).ToList();

            if (treatmentPlan != null && !string.IsNullOrWhiteSpace(treatmentPlan.Description))
            {
                if (treatmentPlan.Description.Trim().StartsWith("{"))
                {
                    try
                    {
                        var planData = System.Text.Json.JsonSerializer.Deserialize<RehabTracking.Web.Features.Healthcare.DoctorDashboard.TreatmentPlanData>(
                            treatmentPlan.Description,
                            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (planData != null && !string.IsNullOrWhiteSpace(planData.DoctorNotes))
                        {
                            parsedDoctorNotes = planData.DoctorNotes;
                        }
                    }
                    catch { }
                }
                else
                {
                    parsedDoctorNotes = treatmentPlan.Description;
                }
            }

            RecalculateRecoveryScore();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading patient data: {ex.Message}");
            sessions = new();
            todaySessions = new();
            hasPatientProfile = false;
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/dashboardHub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<double, double>("ReceiveNewMetrics", (avgEMG, maxROM) =>
        {
            currentEMG = avgEMG;
            liveData.Add(new ChartDataPoint { Time = DateTime.Now, ROMValue = maxROM });
            if (liveData.Count > 30) liveData.RemoveAt(0);
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
        if (patientId > 0)
            await hubConnection.SendAsync("JoinPatientGroup", patientId);

        isLoading = false;
    }

    private void StartSession()
    {
        isExercising = true;
        sessionStartTime = DateTime.Now;
        liveData.Clear();
        sessionSavedMsg = string.Empty;
        _ = SimulateDataLoop();
        _timerCts = new CancellationTokenSource();
        _ = RunSessionTimerAsync(_timerCts.Token);
    }

    private async Task RunSessionTimerAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token) && isExercising)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task StopSession()
    {
        isExercising = false;
        _timerCts?.Cancel();
        _timerCts = null;
        isSavingSession = true;

        var durationMinutes = (int)(DateTime.Now - sessionStartTime).TotalMinutes;

        try
        {
            if (durationMinutes > 0 && patientId > 0)
            {
                var sessionReps = Math.Max(liveData.Count, 1);
                var avgEmg = 0.0;
                var maxRom = liveData.Any() ? (int)liveData.Max(d => d.ROMValue) : 0;

                var saved = await Mediator.Send(new SaveSessionCommand
                {
                    PatientId = patientId,
                    StartTime = sessionStartTime,
                    EndTime = DateTime.Now,
                    DurationMinutes = durationMinutes,
                    RepetitionsCount = sessionReps,
                    MaxRom = maxRom,
                    AvgEmg = avgEmg,
                    DeviceType = "Simulator"
                });

                if (saved)
                {
                    var newSession = new ExerciseSession
                    {
                        PatientId = patientId,
                        StartTime = sessionStartTime.ToUniversalTime(),
                        EndTime = DateTime.UtcNow,
                        DurationMinutes = durationMinutes,
                        RepetitionsCount = sessionReps,
                        MaxRom = maxRom,
                        AvgEmg = avgEmg,
                        DeviceType = "Simulator"
                    };
                    sessions.Insert(0, newSession);
                    todaySessions.Insert(0, newSession);
                    RecalculateRecoveryScore();
                    sessionSavedMsg = $"Chúc mừng Bác đã hoàn thành buổi tập ({durationMinutes} phút)! Dữ liệu đã được lưu an toàn.";
                    sessionSavedSuccess = true;
                    
                    _ = Task.Run(async () => 
                    {
                        await Task.Delay(5000);
                        sessionSavedMsg = string.Empty;
                        await InvokeAsync(StateHasChanged);
                    });
                }
                else
                {
                    sessionSavedMsg = "Có lỗi xảy ra khi lưu buổi tập. Bác vui lòng thử lại nhé.";
                    sessionSavedSuccess = false;
                }
            }
            else
            {
                sessionSavedMsg = "Buổi tập quá ngắn (dưới 1 phút) nên chưa được ghi nhận vào lịch sử.";
                sessionSavedSuccess = false;
            }
        }
        catch (Exception ex)
        {
            sessionSavedMsg = "Có lỗi xảy ra. Bác vui lòng thử lại.";
            sessionSavedSuccess = false;
            Console.WriteLine($"Error saving session: {ex.Message}");
        }
        finally
        {
            isSavingSession = false;
        }
    }

    private string FormatElapsedTime()
    {
        if (!isExercising) return "00:00";
        var elapsed = DateTime.Now - sessionStartTime;
        return $"{(int)elapsed.TotalMinutes:D2}:{elapsed.Seconds:D2}";
    }

    private async Task SimulateDataLoop()
    {
        while (isExercising && hubConnection?.State == HubConnectionState.Connected)
        {
            try
            {
                await hubConnection.SendAsync("SimulateData", patientId);
            }
            catch
            {
                break;
            }
            await Task.Delay(1000);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        _timerCts = null;
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private int CalculatePoints()
    {
        int exercisePoints = sessions.Sum(s => s.RepetitionsCount * 10 + s.DurationMinutes * 5);
        int streakPoints = CalculateStreak() * 50;
        return exercisePoints + streakPoints;
    }

    private int CalculateStreak()
    {
        if (!sessions.Any()) return 0;
        var exerciseDates = sessions
            .Select(s => s.StartTime.ToLocalTime().Date)
            .Distinct()
            .OrderByDescending(d => d)
            .ToList();
            
        if (!exerciseDates.Any()) return 0;
        
        var today = DateTime.Today;
        var yesterday = today.AddDays(-1);
        if (exerciseDates[0] != today && exerciseDates[0] != yesterday) return 0;
        
        int streak = 0;
        var currentCheckDate = exerciseDates[0];
        foreach (var date in exerciseDates)
        {
            if (date == currentCheckDate)
            {
                streak++;
                currentCheckDate = currentCheckDate.AddDays(-1);
            }
            else break;
        }
        return streak;
    }

    private int GetRankTier(int points)
    {
        if (points >= 8000) return 4;
        if (points >= 4000) return 3;
        if (points >= 1500) return 2;
        if (points >= 500) return 1;
        return 0;
    }

    private string GetRankName(int tier) => tier switch
    {
        4 => "Thành Viên Kim Cương",
        3 => "Thành Viên Bạch Kim",
        2 => "Thành Viên Vàng",
        1 => "Thành Viên Bạc",
        _ => "Thành Viên Tích Cực"
    };

    public class ChartDataPoint
    {
        public DateTime Time { get; set; }
        public double ROMValue { get; set; }
    }
}
