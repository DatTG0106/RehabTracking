@page "/exercises"
@page "/patient/exercises"
@using Microsoft.EntityFrameworkCore
@using RehabTracking.Web.Entities
@using RehabTracking.Web.Services
@using System.Security.Claims
@inject RehabTrackingContext Db
@inject NavigationManager Navigation
@inject AuditService AuditService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Kho Bài Tập Vật Lý Trị Liệu – STEP</PageTitle>

<div class="container py-4">
    <!-- Header Banner Thân Thiện Người Cao Tuổi -->
    <div class="senior-card p-4 p-md-5 mb-4" style="background-color: var(--color-primary-surface); border: 2.5px solid var(--color-primary-light);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="senior-badge senior-badge-success mb-2">
                    <i class="bi bi-shield-check"></i> Chuẩn Y Khoa Phục Hồi Chức Năng
                </span>
                <h1 class="fw-bold mb-2 fs-1" style="color: var(--color-text-main);">Kho Bài Tập Vật Lý Trị Liệu</h1>
                <p class="text-muted fs-5 mb-0" style="line-height: 1.6;">
                    Tuyển tập các động tác trị liệu an toàn theo từng vùng khớp (khớp gối, cột sống, khớp vai), có video và hướng dẫn chi tiết từng bước.
                </p>
            </div>
            <div class="col-lg-4 text-center text-lg-end mt-3 mt-lg-0 d-flex flex-column flex-sm-row justify-content-lg-end gap-2">
                <AuthorizeView Roles="Doctor,Admin">
                    <button class="senior-btn senior-btn-secondary" @onclick="OpenCreateExerciseModal">
                        <i class="bi bi-plus-circle-fill text-success fs-5"></i> Thêm Bài Tập
                    </button>
                </AuthorizeView>
                <a href="/patient/workout" class="senior-btn senior-btn-accent shadow">
                    <i class="bi bi-play-circle-fill fs-5"></i> Tập Theo Phác Đồ
                </a>
            </div>
        </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-0" placeholder="Tìm tên bài, triệu chứng, bệnh..." aria-label="Tìm kiếm bài tập" @bind="searchKeyword" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select bg-light border-0" aria-label="Lọc theo vùng khớp" @bind="selectedTargetArea">
                    <option value="">Tất cả vùng khớp</option>
                    <option value="Khớp gối">Khớp gối</option>
                    <option value="Cột sống thắt lưng">Cột sống thắt lưng</option>
                    <option value="Cột sống cổ">Cột sống cổ</option>
                    <option value="Khớp vai">Khớp vai</option>
                    <option value="Cổ chân">Cổ chân & Bàn chân</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select bg-light border-0" aria-label="Lọc theo giai đoạn phục hồi" @bind="selectedPhase">
                    <option value="">Tất cả giai đoạn</option>
                    <option value="Cấp tính">Cấp tính (Acute)</option>
                    <option value="Phục hồi">Phục hồi (Rehab)</option>
                    <option value="Tăng cường">Tăng cường (Strength)</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select bg-light border-0" aria-label="Lọc theo dụng cụ tập" @bind="selectedEquipment">
                    <option value="">Tất cả dụng cụ</option>
                    <option value="Không cần dụng cụ">Không cần dụng cụ</option>
                    <option value="Thảm tập">Thảm tập</option>
                    <option value="Khăn">Khăn cuộn / Dây</option>
                    <option value="Dây kháng lực">Dây kháng lực</option>
                    <option value="Bàn">Bàn / Ghế tựa</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select bg-light border-0" aria-label="Lọc theo mức độ khó" @bind="selectedDifficulty">
                    <option value="0">Tất cả mức độ</option>
                    <option value="1">Cấp độ 1 (Dễ)</option>
                    <option value="2">Cấp độ 2 (Vừa)</option>
                    <option value="3">Cấp độ 3 (Nâng cao)</option>
                </select>
            </div>
            <div class="col-md-1 text-end">
                <button class="btn btn-outline-secondary rounded-pill w-100" @onclick="ResetFilters" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Alert thông báo nếu có thao tác -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Exercise Cards Grid -->
    @if (filteredExercises == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Đang tải kho bài tập y khoa...</p>
        </div>
    }
    else if (!filteredExercises.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm p-5">
            <i class="bi bi-journal-x fs-1 text-muted opacity-50"></i>
            <h5 class="mt-3 fw-bold text-dark">Không tìm thấy bài tập phù hợp</h5>
            <p class="text-muted">Hãy thử thay đổi từ khóa hoặc bộ lọc vùng khớp / dụng cụ.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ex in filteredExercises)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden exercise-hover-card bg-white position-relative">
                        <div class="position-relative bg-dark" style="height: 190px;">
                            <img src="@(string.IsNullOrEmpty(ex.ThumbnailUrl) ? "/images/exercises/default_thumb.jpg" : ex.ThumbnailUrl)" 
                                 alt="@ex.Title" 
                                 class="w-100 h-100" 
                                 style="object-fit: cover; opacity: 0.88;"
                                 onerror="this.src='https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600&auto=format&fit=crop&q=80'" />
                            <div class="position-absolute top-0 start-0 m-3 d-flex flex-wrap gap-1">
                                <span class="badge bg-primary bg-opacity-90 rounded-pill px-2.5 py-1 fw-normal">
                                    <i class="bi bi-geo-alt-fill me-1"></i> @ex.TargetArea
                                </span>
                                <span class="badge @GetPhaseBadgeClass(ex.RecoveryPhase) rounded-pill px-2.5 py-1 fw-normal">
                                    @ex.RecoveryPhase
                                </span>
                            </div>
                            <div class="position-absolute bottom-0 start-0 m-3">
                                <span class="badge bg-dark bg-opacity-75 rounded-pill px-2.5 py-1 text-white small">
                                    <i class="bi bi-tools me-1"></i> @(string.IsNullOrEmpty(ex.Equipment) ? "Không cần dụng cụ" : ex.Equipment)
                                </span>
                            </div>
                            <div class="position-absolute bottom-0 end-0 m-3">
                                <span class="badge bg-dark bg-opacity-75 rounded-pill px-2.5 py-1 text-white small">
                                    <i class="bi bi-clock me-1"></i> @(ex.DefaultDurationSeconds / 60) phút
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-1">@ex.Title</h5>
                            
                            @if (!string.IsNullOrEmpty(ex.ApplicableConditions))
                            {
                                <div class="text-primary small fw-semibold mb-2" style="font-size: 0.8rem;">
                                    <i class="bi bi-clipboard2-pulse me-1"></i>@ex.ApplicableConditions
                                </div>
                            }

                            <p class="card-text text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @ex.Description
                            </p>

                            <div class="d-flex align-items-center justify-content-between mb-3 pt-2 border-top">
                                <div class="small">
                                    <span class="text-muted">Độ khó:</span>
                                    <span class="fw-bold text-warning ms-1">
                                        @for (int i = 1; i <= 3; i++)
                                        {
                                            <i class="bi @(i <= ex.Difficulty ? "bi-star-fill" : "bi-star text-muted opacity-25")"></i>
                                        }
                                    </span>
                                </div>
                                <div class="small">
                                    <span class="text-muted">Ngưỡng đau:</span>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-2">
                                        VAS &le; @ex.RecommendedPainMax/10
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary rounded-pill flex-grow-1 py-2 fw-semibold" @onclick="() => OpenDetailModal(ex)">
                                    <i class="bi bi-info-circle me-1"></i> Chi tiết
                                </button>
                                <a href="/patient/workout" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold" title="Tập bài này">
                                    <i class="bi bi-play-fill fs-5 align-middle"></i>
                                </a>
                            </div>

                            <AuthorizeView Roles="Doctor,Admin">
                                <div class="d-flex gap-2 mt-2 pt-2 border-top">
                                    <button class="btn btn-sm btn-outline-secondary w-50 rounded-pill" @onclick="() => OpenEditExerciseModal(ex)">
                                        <i class="bi bi-pencil me-1"></i> Sửa
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger w-50 rounded-pill" @onclick="() => ConfirmDeleteExercise(ex)">
                                        <i class="bi bi-trash me-1"></i> Xóa
                                    </button>
                                </div>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal Chi Tiết Bài Tập -->
@if (selectedExercise != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1050;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <div>
                        <div class="d-flex gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">@selectedExercise.TargetArea • @selectedExercise.RecoveryPhase</span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">Dụng cụ: @(string.IsNullOrEmpty(selectedExercise.Equipment) ? "Không cần" : selectedExercise.Equipment)</span>
                        </div>
                        <h4 class="modal-title fw-bold text-dark">@selectedExercise.Title</h4>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseDetailModal"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    @if (!string.IsNullOrEmpty(selectedExercise.VideoUrl))
                    {
                        <div class="rounded-3 overflow-hidden mb-4 shadow-sm bg-black position-relative" style="aspect-ratio: 16/9;">
                            <iframe src="@selectedExercise.VideoUrl" title="Video hướng dẫn kỹ thuật bài tập phục hồi chức năng" class="w-100 h-100 border-0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                        </div>
                    }

                    <div class="row g-3 mb-4 text-center">
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block">Hiệp & Lặp lại</small>
                                <span class="fw-bold fs-5 text-primary">@selectedExercise.DefaultSets Hiệp × @selectedExercise.DefaultReps Lần</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block">Thời gian giữ</small>
                                <span class="fw-bold fs-5 text-success">@selectedExercise.HoldSeconds Giây</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted d-block">Nghỉ giữa hiệp</small>
                                <span class="fw-bold fs-5 text-secondary">@selectedExercise.RestSeconds Giây</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedExercise.ApplicableConditions))
                    {
                        <div class="p-3 bg-primary-subtle rounded-3 mb-3 border border-primary-subtle">
                            <h6 class="fw-bold text-primary mb-1"><i class="bi bi-check2-circle me-2"></i>Chỉ định / Tình trạng áp dụng:</h6>
                            <p class="small mb-0 text-dark">@selectedExercise.ApplicableConditions</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(selectedExercise.Contraindications))
                    {
                        <div class="p-3 bg-danger-subtle rounded-3 mb-3 border border-danger-subtle">
                            <h6 class="fw-bold text-danger mb-1"><i class="bi bi-slash-circle-fill me-2"></i>Chống chỉ định y khoa (Không tập khi):</h6>
                            <p class="small mb-0 text-danger-emphasis">@selectedExercise.Contraindications</p>
                        </div>
                    }

                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-list-ol text-primary me-2"></i>Hướng dẫn thực hiện từng bước:</h6>
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <ol class="mb-0 ps-3">
                            @foreach (var step in ParseJsonList(selectedExercise.StepInstructionsJson))
                            {
                                <li class="mb-2 text-secondary">@step</li>
                            }
                        </ol>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedExercise.CommonMistakesJson))
                    {
                        <h6 class="fw-bold text-warning-emphasis mb-2"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Các lỗi sai tư thế thường gặp:</h6>
                        <div class="p-3 bg-warning-subtle rounded-3 mb-3 border border-warning-subtle">
                            <ul class="mb-0 ps-3">
                                @foreach (var mistake in ParseJsonList(selectedExercise.CommonMistakesJson))
                                {
                                    <li class="mb-1 text-dark">@mistake</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(selectedExercise.RedFlagWarnings))
                    {
                        <div class="p-3 bg-danger-subtle text-danger rounded-3 border border-danger-subtle mb-3">
                            <h6 class="fw-bold mb-1"><i class="bi bi-shield-fill-x me-2"></i>Dấu hiệu dừng khẩn cấp (Red Flags):</h6>
                            <p class="small mb-0">@selectedExercise.RedFlagWarnings</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(selectedExercise.TherapeuticBenefits))
                    {
                        <div class="p-3 bg-success-subtle text-success-emphasis rounded-3 border border-success-subtle">
                            <h6 class="fw-bold mb-1"><i class="bi bi-heart-pulse-fill me-2"></i>Lợi ích trị liệu:</h6>
                            <p class="small mb-0">@selectedExercise.TherapeuticBenefits</p>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseDetailModal">Đóng</button>
                    <a href="/patient/workout" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-play-circle-fill me-2"></i> Bắt đầu tập ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Bác Sĩ / Admin: Thêm / Chỉnh Sửa Bài Tập -->
@if (showEditModal && editingExercise != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-pencil-square text-primary me-2"></i>@(editingExercise.ExerciseId == 0 ? "Thêm Bài Tập Mới" : "Cập Nhật Bài Tập")
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showEditModal = false"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">Tên bài tập (*)</label>
                            <input type="text" class="form-control rounded-3" @bind="editingExercise.Title" placeholder="Ví dụ: Gập duỗi gối chủ động" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Vùng cơ khớp (*)</label>
                            <select class="form-select rounded-3" @bind="editingExercise.TargetArea">
                                <option value="Khớp gối">Khớp gối</option>
                                <option value="Cột sống thắt lưng">Cột sống thắt lưng</option>
                                <option value="Cột sống cổ">Cột sống cổ</option>
                                <option value="Khớp vai">Khớp vai</option>
                                <option value="Cổ chân">Cổ chân</option>
                                <option value="Khớp háng">Khớp háng</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Giai đoạn phục hồi</label>
                            <select class="form-select rounded-3" @bind="editingExercise.RecoveryPhase">
                                <option value="Cấp tính">Cấp tính</option>
                                <option value="Phục hồi">Phục hồi</option>
                                <option value="Tăng cường">Tăng cường</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Độ khó (1: Dễ - 3: Nâng cao)</label>
                            <select class="form-select rounded-3" @bind="editingExercise.Difficulty">
                                <option value="1">1 - Dễ (Khởi đầu)</option>
                                <option value="2">2 - Vừa phải</option>
                                <option value="3">3 - Nâng cao</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Ngưỡng đau tối đa (VAS 1-10)</label>
                            <input type="number" class="form-control rounded-3" min="1" max="10" @bind="editingExercise.RecommendedPainMax" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Số Sets (Hiệp)</label>
                            <input type="number" class="form-control rounded-3" min="1" max="10" @bind="editingExercise.DefaultSets" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Số Reps (Lần/hiệp)</label>
                            <input type="number" class="form-control rounded-3" min="1" max="50" @bind="editingExercise.DefaultReps" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Giữ mỗi rep (Giây)</label>
                            <input type="number" class="form-control rounded-3" min="0" max="60" @bind="editingExercise.HoldSeconds" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Nghỉ giữa hiệp (Giây)</label>
                            <input type="number" class="form-control rounded-3" min="10" max="180" @bind="editingExercise.RestSeconds" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Dụng cụ yêu cầu</label>
                            <input type="text" class="form-control rounded-3" @bind="editingExercise.Equipment" placeholder="Không cần dụng cụ / Thảm tập / Khăn..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Video URL (YouTube Embed)</label>
                            <input type="text" class="form-control rounded-3" @bind="editingExercise.VideoUrl" placeholder="https://www.youtube.com/embed/..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Tình trạng / Chấn thương áp dụng</label>
                            <input type="text" class="form-control rounded-3" @bind="editingExercise.ApplicableConditions" placeholder="Ví dụ: Phục hồi đứt ACL, Thoái hóa khớp gối..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-danger">Chống chỉ định (Không tập khi)</label>
                            <input type="text" class="form-control rounded-3" @bind="editingExercise.Contraindications" placeholder="Ví dụ: Vết mổ rỉ dịch, sốt cao, sưng nóng đỏ cấp..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Mô tả bài tập</label>
                            <textarea class="form-control rounded-3" rows="2" @bind="editingExercise.Description"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Các bước thực hiện (Mỗi bước 1 dòng)</label>
                            <textarea class="form-control rounded-3" rows="3" @bind="tempStepsText" placeholder="Bước 1: ...&#10;Bước 2: ..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-warning-emphasis">Lỗi sai thường gặp (Mỗi lỗi 1 dòng)</label>
                            <textarea class="form-control rounded-3" rows="2" @bind="tempMistakesText" placeholder="Lỗi 1...&#10;Lỗi 2..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-danger">Cảnh báo dấu hiệu nguy hiểm (Red Flags)</label>
                            <input type="text" class="form-control rounded-3" @bind="editingExercise.RedFlagWarnings" placeholder="Đau nhói dữ dội, khớp gối sưng to căng bóng..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-success">Lợi ích trị liệu</label>
                            <input type="text" class="form-control rounded-3" @bind="editingExercise.TherapeuticBenefits" placeholder="Tăng biên độ gập duỗi, chống teo cơ..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => showEditModal = false">Hủy</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="SaveExerciseAsync">
                        <i class="bi bi-save me-1"></i> Lưu Bài Tập
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .exercise-hover-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .exercise-hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
    }
</style>

@code {
    private List<Exercise>? allExercises;
    private Exercise? selectedExercise;
    private Exercise? editingExercise;
    private bool showEditModal = false;
    private string? statusMessage;

    private string searchKeyword = "";
    private string selectedTargetArea = "";
    private string selectedPhase = "";
    private string selectedEquipment = "";
    private int selectedDifficulty = 0;

    private string tempStepsText = "";
    private string tempMistakesText = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadExercisesAsync();
    }

    private async Task LoadExercisesAsync()
    {
        allExercises = await Db.Exercises.Where(e => e.IsActive).OrderBy(e => e.ExerciseId).ToListAsync();
    }

    private IEnumerable<Exercise> filteredExercises =>
        (allExercises ?? Enumerable.Empty<Exercise>()).Where(e =>
            (string.IsNullOrWhiteSpace(searchKeyword) || 
             e.Title.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) || 
             e.Description.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) ||
             (!string.IsNullOrEmpty(e.ApplicableConditions) && e.ApplicableConditions.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrWhiteSpace(selectedTargetArea) || e.TargetArea == selectedTargetArea) &&
            (string.IsNullOrWhiteSpace(selectedPhase) || e.RecoveryPhase == selectedPhase) &&
            (string.IsNullOrWhiteSpace(selectedEquipment) || (!string.IsNullOrEmpty(e.Equipment) && e.Equipment.Contains(selectedEquipment, StringComparison.OrdinalIgnoreCase))) &&
            (selectedDifficulty == 0 || e.Difficulty == selectedDifficulty)
        );

    private void ResetFilters()
    {
        searchKeyword = "";
        selectedTargetArea = "";
        selectedPhase = "";
        selectedEquipment = "";
        selectedDifficulty = 0;
    }

    private void OpenDetailModal(Exercise ex) => selectedExercise = ex;
    private void CloseDetailModal() => selectedExercise = null;

    private void OpenCreateExerciseModal()
    {
        editingExercise = new Exercise
        {
            Title = "",
            TargetArea = "Khớp gối",
            RecoveryPhase = "Phục hồi",
            Difficulty = 1,
            RecommendedPainMax = 4,
            DefaultDurationSeconds = 300,
            DefaultSets = 3,
            DefaultReps = 10,
            HoldSeconds = 5,
            RestSeconds = 30,
            Equipment = "Thảm tập",
            ApplicableConditions = "",
            Contraindications = "",
            Description = ""
        };
        tempStepsText = "";
        tempMistakesText = "";
        showEditModal = true;
    }

    private void OpenEditExerciseModal(Exercise ex)
    {
        editingExercise = new Exercise
        {
            ExerciseId = ex.ExerciseId,
            Title = ex.Title,
            TargetArea = ex.TargetArea,
            RecoveryPhase = ex.RecoveryPhase,
            Difficulty = ex.Difficulty,
            RecommendedPainMax = ex.RecommendedPainMax,
            DefaultDurationSeconds = ex.DefaultDurationSeconds,
            DefaultSets = ex.DefaultSets,
            DefaultReps = ex.DefaultReps,
            HoldSeconds = ex.HoldSeconds,
            RestSeconds = ex.RestSeconds,
            Equipment = ex.Equipment,
            ApplicableConditions = ex.ApplicableConditions,
            Contraindications = ex.Contraindications,
            Description = ex.Description,
            VideoUrl = ex.VideoUrl,
            ThumbnailUrl = ex.ThumbnailUrl,
            StepInstructionsJson = ex.StepInstructionsJson,
            CommonMistakesJson = ex.CommonMistakesJson,
            RedFlagWarnings = ex.RedFlagWarnings,
            TherapeuticBenefits = ex.TherapeuticBenefits
        };

        var steps = ParseJsonList(ex.StepInstructionsJson);
        tempStepsText = string.Join("\n", steps);

        var mistakes = ParseJsonList(ex.CommonMistakesJson);
        tempMistakesText = string.Join("\n", mistakes);

        showEditModal = true;
    }

    private async Task SaveExerciseAsync()
    {
        if (editingExercise == null || string.IsNullOrWhiteSpace(editingExercise.Title))
        {
            statusMessage = "Vui lòng nhập tên bài tập.";
            return;
        }

        // Serialize steps & mistakes
        var stepsList = tempStepsText.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim()).Where(s => s.Length > 0).ToList();
        editingExercise.StepInstructionsJson = System.Text.Json.JsonSerializer.Serialize(stepsList);

        var mistakesList = tempMistakesText.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(m => m.Trim()).Where(m => m.Length > 0).ToList();
        editingExercise.CommonMistakesJson = System.Text.Json.JsonSerializer.Serialize(mistakesList);

        if (editingExercise.ExerciseId == 0)
        {
            // Thêm mới
            editingExercise.CreatedAt = DateTime.UtcNow;
            editingExercise.IsActive = true;
            Db.Exercises.Add(editingExercise);
            await Db.SaveChangesAsync();

            await AuditService.LogAsync("Tao_BaiTap_Moi", nameof(Exercise), editingExercise.ExerciseId.ToString(), null, $"Thêm bài tập '{editingExercise.Title}'");
            statusMessage = $"Đã tạo bài tập '{editingExercise.Title}' thành công!";
        }
        else
        {
            // Cập nhật
            var existing = await Db.Exercises.FindAsync(editingExercise.ExerciseId);
            if (existing != null)
            {
                existing.Title = editingExercise.Title;
                existing.TargetArea = editingExercise.TargetArea;
                existing.RecoveryPhase = editingExercise.RecoveryPhase;
                existing.Difficulty = editingExercise.Difficulty;
                existing.RecommendedPainMax = editingExercise.RecommendedPainMax;
                existing.DefaultDurationSeconds = editingExercise.DefaultDurationSeconds;
                existing.DefaultSets = editingExercise.DefaultSets;
                existing.DefaultReps = editingExercise.DefaultReps;
                existing.HoldSeconds = editingExercise.HoldSeconds;
                existing.RestSeconds = editingExercise.RestSeconds;
                existing.Equipment = editingExercise.Equipment;
                existing.ApplicableConditions = editingExercise.ApplicableConditions;
                existing.Contraindications = editingExercise.Contraindications;
                existing.Description = editingExercise.Description;
                existing.VideoUrl = editingExercise.VideoUrl;
                existing.ThumbnailUrl = editingExercise.ThumbnailUrl;
                existing.StepInstructionsJson = editingExercise.StepInstructionsJson;
                existing.CommonMistakesJson = editingExercise.CommonMistakesJson;
                existing.RedFlagWarnings = editingExercise.RedFlagWarnings;
                existing.TherapeuticBenefits = editingExercise.TherapeuticBenefits;

                await Db.SaveChangesAsync();
                await AuditService.LogAsync("CapNhat_BaiTap", nameof(Exercise), existing.ExerciseId.ToString(), null, $"Cập nhật bài tập '{existing.Title}'");
                statusMessage = $"Đã cập nhật bài tập '{existing.Title}' thành công!";
            }
        }

        showEditModal = false;
        await LoadExercisesAsync();
    }

    private async Task ConfirmDeleteExercise(Exercise ex)
    {
        ex.IsActive = false;
        await Db.SaveChangesAsync();
        await AuditService.LogAsync("Xoa_BaiTap", nameof(Exercise), ex.ExerciseId.ToString(), null, $"Vô hiệu hóa bài tập '{ex.Title}'");
        statusMessage = $"Đã xóa bài tập '{ex.Title}' khỏi danh mục hoạt động.";
        await LoadExercisesAsync();
    }

    private static string GetPhaseBadgeClass(string phase) => phase switch
    {
        "Cấp tính" => "bg-danger bg-opacity-90 text-white",
        "Phục hồi" => "bg-success bg-opacity-90 text-white",
        "Tăng cường" => "bg-indigo text-white",
        _ => "bg-secondary text-white"
    };

    private static List<string> ParseJsonList(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new List<string>();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
        }
        catch
        {
            return new List<string> { json };
        }
    }
}
